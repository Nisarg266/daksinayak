{% comment %}
  Renders a product card with "Dakshinayan" Custom Design
  - Responsive Flexbox layout
  - Custom Cart Icon for Quick Add
  - Uses "stretched link" pattern: the title link's ::after covers the whole card,
    while the cart button sits above it via z-index.
{% endcomment %}

{%- unless skip_styles -%}
  {{ 'component-rating.css' | asset_url | stylesheet_tag }}
  {{ 'component-volume-pricing.css' | asset_url | stylesheet_tag }}
  {{ 'component-price.css' | asset_url | stylesheet_tag }}
  {{ 'quick-order-list.css' | asset_url | stylesheet_tag }}
  {{ 'quantity-popover.css' | asset_url | stylesheet_tag }}
{%- endunless -%}

<style>
  .figma-card {
    display: flex;
    flex-direction: column;
    justify-content: flex-start;
    align-items: flex-start;
    width: 100%;
    position: relative;
    gap: 8px;
    padding: 16px;
    border: 1px solid rgba(25, 25, 25, 0.08);
    background: transparent;
    box-sizing: border-box;
  }

  .figma-image-area {
    flex-grow: 0;
    flex-shrink: 0;
    width: 100%;
    height: 310px;
    position: relative;
    display: flex;
    justify-content: center;
    align-items: center;
    overflow: visible;
  }

  .main-product-img {
    width: 100%;
    height: 100% !important;
    object-fit: cover;
    position: relative;
    z-index: 2;
    transition: all 0.4s ease;
  }

  .figma-content-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    align-self: stretch;
    flex-grow: 0;
    flex-shrink: 0;
    position: relative;
    width: 100%;
  }

  .figma-text-col {
    display: flex;
    flex-direction: column;
    justify-content: flex-start;
    align-items: flex-start;
    flex-grow: 0;
    flex-shrink: 0;
    gap: 8px;
    max-width: 70%;
  }

  .figma-title {
    font-size: 20px;
    font-weight: 500;
    text-align: left;
    color: var(--color-custom-black);
    margin: 0;
    text-decoration: none;
    line-height: 1.2;
    transition: color 0.4s ease;
  }

  .figma-price-text {
    font-size: 18px;
    text-align: left;
    color: var(--color-custom-black);
    margin: 0;
  }

  .figma-price-text .price,
  .figma-price-text .price-item {
    font-size: 18px !important;
    color: var(--color-custom-black) !important;
    letter-spacing: 0 !important;
  }

  .custom-dak-card .price-item {
    word-spacing: -0.3ch;
  }

  .figma-svg-btn {
    flex-grow: 0;
    flex-shrink: 0;
    width: 56px;
    border: 1px solid var(--color-custom-black) !important;
    height: 56px;
    position: relative;
    background: transparent;
    border: none;
    padding: 0;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: all 0.4s ease;
  }

  .figma-svg-btn svg {
    pointer-events: none;
  }

  @media screen and (min-width: 990px) {
    .figma-card:hover .main-product-img {
      transform: scale(1.05);
    }

    .figma-card:hover:hover .figma-svg-btn {
      background-color: var(--color-primary);
      border: 1px solid var(--color-primary) !important;
    }

    .figma-card:hover .figma-title {
      color: var(--color-heading);
    }
  }

  @media screen and (max-width: 990px) {
    .figma-image-area {
      height: 240px;
    }

    .main-product-img {
      width: 100% !important;
      height: 100% !important;
    }

    .figma-title {
      font-size: 16px;
    }

    .figma-price-text,
    .figma-price-text .price,
    .figma-price-text .price-item {
      font-size: 15px !important;
    }

    .figma-svg-btn {
      width: 44px;
      height: 44px;
    }

    .figma-svg-btn svg {
      width: 44px;
      height: 44px;
    }
  }

  .custom-dak-card {
    border: 1px solid rgba(25, 25, 25, 0.08);
    padding: 16px;
    display: flex;
    flex-direction: column;
    gap: 8px;
    height: 100%;
    position: relative;
    background: transparent;
    transition: box-shadow 0.3s ease;
  }

  .quick-add {
    margin: 0;
  }

  /* ========================================
     STRETCHED LINK: Makes the entire card
     clickable via the title link's ::after
     ======================================== */
  .custom-dak-title {
    font-size: 16px;
    font-weight: 500;
    color: #191919;
    text-decoration: none;
    line-height: 1.2;
    transition: color 0.4s ease;
    /* Needed so ::after positions relative to this element's containing block (.custom-dak-card) */
    position: static;
  }

  .custom-dak-title::after {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    z-index: 1;
    /* Invisible overlay covering the entire .custom-dak-card */
  }

  /* Cart button must sit ABOVE the stretched link overlay */
  .custom-dak-action {
    position: relative;
    z-index: 2;
  }

  /* --- ANIMATION TRIGGERS --- */
  @media screen and (min-width: 990px) {
    .custom-dak-card:hover .main-product-img {
      transform: scale(1.05);
    }

    .custom-dak-card:hover {
      border: 1px solid #E8202B1A;
    }
  }

  .custom-dak-image-wrapper {
    position: relative;
    width: 100%;
    padding-bottom: 100%;
    overflow: hidden;
    margin-bottom: 1rem;
    display: flex;
    justify-content: center;
    align-items: center;
    border-radius: 4px;
  }

  /* Main Product Image */
  .custom-dak-image-wrapper .main-product-img {
    position: absolute;
    top: 0 !important;
    left: 0 !important;
    width: 100% !important;
    height: 100% !important;
    object-fit: cover;
    z-index: 2;
    transition: transform 0.4s ease;
  }

  /* Rest of your layout styles */
  .custom-dak-bottom {
    display: flex;
    justify-content: space-between;
    margin-top: auto;
    align-items: flex-end;
  }

  .custom-dak-info {
    display: flex;
    flex-direction: column;
    gap: 4px;
    max-width: 70%;
  }

  .custom-dak-card:hover .custom-dak-title {
    color: var(--color-heading);
    text-decoration: none;
  }

  .custom-dak-card:hover .custom-icon-btn svg {
    fill: var(--color-primary)
  }

  .custom-dak-card:hover .custom-icon-btn {
    border-color: var(--color-primary);
    background: var(--color-primary);
  }

  .custom-icon-btn {
    background: none;
    border: 1px solid #191919;
    padding: 0;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: transform 0.2s ease, border-color 0.4s ease;
    /* Ensure button is above the stretched link */
    position: relative;
    z-index: 2;
  }

  .custom-icon-btn svg {
    transition: fill 0.4s ease;
  }

  .custom-icon-btn:hover {
    transform: scale(1.05);
  }

  .custom-icon-btn .loading__spinner {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    background: rgba(255, 255, 255, 0.85);
    backdrop-filter: blur(2px);
    z-index: 2;
  }

  .custom-icon-btn .loading__spinner .spinner {
    width: 24px;
    height: 24px;
  }

  .custom-icon-btn .loading__spinner .path {
    stroke: var(--color-primary, #C8A96E);
    stroke-width: 4;
  }


  /* --- MOBILE ADJUSTMENTS --- */
  @media screen and (max-width: 990px) {
    .custom-dak-card {
      padding: 8px;
      gap: 4px;
    }

    .custom-dak-image-wrapper {
      margin-bottom: 1.5rem;
    }

    .custom-dak-image-wrapper .main-product-img {
      width: 100% !important;
      height: 100% !important;
      max-width: none !important;
      max-height: none !important;
    }

    .custom-dak-title {
      font-size: 13px;
    }

    /* Force price reduction */
    .custom-dak-info .price-item {
      font-size: 12px !important;
    }

    .custom-icon-btn svg {
      width: 100%;
      height: 100%;
    }

    .custom-icon-btn .loading__spinner .spinner {
      width: 18px;
      height: 18px;
    }
  }

  @media screen and (min-width: 1024px) and (max-width: 1180px) {

    .figma-card,
    .custom-dak-card {
      padding: 8px;
      gap: 4px;

    }

    .custom-dak-card:hover .main-product-img {
      transform: scale(1.05);
    }

    .figma-image-area {
      height: 180px;
    }

    .main-product-img,
    .custom-dak-image-wrapper .main-product-img {
      max-width: none !important;
      height: 100% !important;
    }

    .figma-svg-btn {
      width: 32px;
      height: 32px;
    }

    .figma-svg-btn svg {
      width: 28px;
      height: 28px;
    }

    .custom-icon-btn svg {
      width: 100%;
      height: 100%;
    }

    .custom-dak-image-wrapper {
      margin-bottom: 0.4rem;
    }
  }


  @media screen and (min-width: 1024px) and (max-width: 1180px) {
    .figma-title,
    .custom-dak-title {
      font-size: 14px;
    }

    .figma-price-text .price-item,
    .custom-dak-info .price-item {
      font-size: 16px !important;
    }
  }

  @media (1141px <=width <=1350px) {
    .figma-price-text .price-item,
    .custom-dak-info .price-item {
      font-size: 16px !important;
    }

    .main-product-img,
    .custom-dak-image-wrapper .main-product-img {
      max-width: none !important;
      height: 100% !important;
    }
  }

  @media screen and (min-width: 1181px) {
    .custom-forced-grid {
      gap: 4rem;
      padding: 0 240px;
    }

    .custom-dak-image-wrapper .main-product-img {
      max-width: none !important;
      height: 100% !important;
    }
  }

  @media screen and (min-width: 1920px) {
    .custom-dak-title {
      font-size: 24px !important;
    }

    .price {
      font-size: 20px !important;
    }
  }

  .custom-dak-sold-out-overlay {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: rgba(255, 255, 255, 0.48);
    display: flex;
    align-items: center;
    justify-content: center;
    z-index: 3;
    pointer-events: none;
    transition: background 0.3s ease;
    border-radius: 4px;
  }

  .custom-dak-sold-out-text {
    color: #ffffff !important;
    font-family: 'Playfair Display', 'Tasman', Georgia, 'Times New Roman', serif !important;
    font-size: clamp(20px, 3.5vw, 34px);
    line-height: 1.1;
    text-align: center;
    font-weight: 500;
    letter-spacing: 0.03em;
    text-shadow: 0 2px 12px rgba(0, 0, 0, 0.7), 0 0 4px rgba(0, 0, 0, 0.6);
    user-select: none;
    display: block;
    text-transform: none;
  }

  .custom-dak-card:hover .custom-dak-sold-out-overlay {
    background: rgba(255, 255, 255, 0.58);
  }

  .custom-dak-card.is-sold-out .custom-icon-btn,
  .custom-dak-card.is-sold-out button[name="add"] {
    opacity: 0.5 !important;
    cursor: not-allowed !important;
    pointer-events: none !important;
    border-color: rgba(25, 25, 25, 0.35) !important;
    background: transparent !important;
  }

  .custom-dak-card.is-sold-out:hover .custom-icon-btn {
    background: transparent !important;
    border-color: rgba(25, 25, 25, 0.35) !important;
  }

  .custom-dak-card.is-sold-out:hover .custom-icon-btn svg {
    fill: none !important;
  }
</style>

{%- liquid
  if card_product == nil and product != nil
    assign card_product = product
  endif
-%}

{%- if card_product and card_product != empty -%}
  {%- comment -%}
    NO outer <a> wrapper. Instead the .custom-dak-title link uses a
    ::after pseudo-element to stretch over the entire card.
    The cart button sits above it via z-index.
  {%- endcomment -%}
  <div class="card-wrapper product-card-wrapper underline-links-hover">
    <div class="custom-dak-card{% if card_product.available == false %} is-sold-out{% endif %}">
      {%- comment -%} IMAGE SECTION {%- endcomment -%}
      <a href="{{ card_product.url }}" class="custom-dak-title">
        <div class="custom-dak-image-wrapper">
          {%- if card_product.featured_media -%}
            <img
              srcset="
                {%- if card_product.featured_media.width >= 165 -%}{{ card_product.featured_media | image_url: width: 165 }} 165w,{%- endif -%}
                {%- if card_product.featured_media.width >= 360 -%}{{ card_product.featured_media | image_url: width: 360 }} 360w,{%- endif -%}
                {{ card_product.featured_media | image_url }} {{ card_product.featured_media.width }}w
              "
              src="{{ card_product.featured_media | image_url: width: 533 }}"
              sizes="(min-width: {{ settings.page_width }}px) {{ settings.page_width | minus: 130 | divided_by: 4 }}px, (min-width: 990px) calc((100vw - 130px) / 4), (min-width: 750px) calc((100vw - 120px) / 3), calc((100vw - 35px) / 2)"
              alt="{{ card_product.featured_media.alt | escape }}"
              loading="lazy"
              width="{{ card_product.featured_media.width }}"
              height="{{ card_product.featured_media.height }}"
              class="main-product-img"
            >

          {%- else -%}
            {{ 'product-apparel-2' | placeholder_svg_tag: 'placeholder-svg' }}
          {%- endif -%}

          {%- if card_product.available == false -%}
            <div class="custom-dak-sold-out-overlay" aria-hidden="true">
              <span class="custom-dak-sold-out-text">
                {%- assign sold_out_text = 'products.product.sold_out' | t -%}
                {%- if sold_out_text contains ' ' -%}
                  {{ sold_out_text | replace_first: ' ', '<br>' }}
                {%- else -%}
                  {{ sold_out_text }}
                {%- endif -%}
              </span>
            </div>
          {%- endif -%}
        </div>
      </a>

      {%- comment -%} BOTTOM SECTION (Title/Price Left, Cart Button Right) {%- endcomment -%}
      <div class="custom-dak-bottom">
        <div class="custom-dak-info">
          {%- comment -%}
            This <a> tag is the ONLY link. Its ::after pseudo-element
            stretches to cover the entire .custom-dak-card, making
            the whole card clickable.
          {%- endcomment -%}
          <a href="{{ card_product.url }}" class="custom-dak-title">
            {{ card_product.title | escape }}
          </a>
          {% render 'price', product: card_product, price_class: '', show_compare_at_price: true %}
        </div>

        <div class="custom-dak-action">
          {% assign product_form_id = 'quick-add-' | append: section_id | append: card_product.id %}

          {%- if quick_add == 'standard' -%}
            <div class="quick-add no-js-hidden">
              {%- liquid
                assign qty_rules = false
                if card_product.selected_or_first_available_variant.quantity_rule.min > 1 or card_product.selected_or_first_available_variant.quantity_rule.max != null or card_product.selected_or_first_available_variant.quantity_rule.increment > 1
                  assign qty_rules = true
                endif
              -%}

              {%- if card_product.variants_count > 1 or qty_rules -%}
                <modal-opener data-modal="#QuickAdd-{{ card_product.id }}">
                  <button
                    id="{{ product_form_id }}-submit"
                    type="submit"
                    name="add"
                    class="custom-icon-btn"
                    aria-haspopup="dialog"
                    aria-labelledby="{{ product_form_id }}-submit title-{{ section_id }}-{{ card_product.id }}"
                    data-product-url="{{ card_product.url }}"
                    {% if card_product.available == false %}
                      disabled
                    {% endif %}
                  >
                    <svg width="42" height="42" viewBox="0 0 56 56" fill="none" xmlns="http://www.w3.org/2000/svg">
                      <path d="M25.0227 40.2953C26.3037 40.2953 27.3422 39.2568 27.3422 37.9758C27.3422 36.6947 26.3037 35.6562 25.0227 35.6562C23.7416 35.6562 22.7031 36.6947 22.7031 37.9758C22.7031 39.2568 23.7416 40.2953 25.0227 40.2953Z" stroke="#191919" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round"/>
                      <path d="M35.1281 40.2953C36.4092 40.2953 37.4477 39.2568 37.4477 37.9758C37.4477 36.6947 36.4092 35.6562 35.1281 35.6562C33.8471 35.6562 32.8086 36.6947 32.8086 37.9758C32.8086 39.2568 33.8471 40.2953 35.1281 40.2953Z" stroke="#191919" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round"/>
                      <path d="M19.6456 19.5748L22.3865 28.253C22.8079 29.5866 23.0179 30.2535 23.4229 30.7471C23.7774 31.1835 24.2397 31.5203 24.762 31.7289C25.3552 31.9648 26.0533 31.9648 27.4524 31.9648H32.7092C34.1083 31.9648 34.8065 31.9648 35.3983 31.7289C35.922 31.5203 36.3829 31.1835 36.7388 30.7471C37.1424 30.2535 37.3524 29.5866 37.7752 28.253L38.3329 26.4857L38.6602 25.4412L39.1115 24.0094C39.2726 23.4987 39.3111 22.9572 39.2239 22.4289C39.1367 21.9006 38.9263 21.4002 38.6097 20.9683C38.2931 20.5365 37.8793 20.1853 37.4016 19.9432C36.924 19.7011 36.3961 19.5749 35.8606 19.5748H19.6456ZM19.6456 19.5748L19.6306 19.5244C19.573 19.3315 19.5094 19.1405 19.4397 18.9516C19.1636 18.2528 18.6955 17.6464 18.0893 17.2024C17.4832 16.7584 16.7638 16.495 16.0142 16.4425C15.8738 16.4316 15.7197 16.4316 15.4102 16.4316" stroke="#191919" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round"/>
                      <circle cx="30" cy="26" r="1" fill="#191919"/>
                    </svg>
                    {%- render 'loading-spinner' -%}
                  </button>
                </modal-opener>

                <quick-add-modal id="QuickAdd-{{ card_product.id }}" class="quick-add-modal">
                  <div
                    role="dialog"
                    aria-label="{{ 'products.product.choose_product_options' | t: product_name: card_product.title | escape }}"
                    aria-modal="true"
                    class="quick-add-modal__content global-settings-popup"
                    tabindex="-1"
                  >
                    <button
                      id="ModalClose-{{ card_product.id }}"
                      type="button"
                      class="quick-add-modal__toggle"
                      aria-label="{{ 'accessibility.close' | t }}"
                    >
                      {{- 'icon-close.svg' | inline_asset_content -}}
                    </button>
                    <div id="QuickAddInfo-{{ card_product.id }}" class="quick-add-modal__content-info"></div>
                  </div>
                </quick-add-modal>

              {%- else -%}
                <product-form data-section-id="{{ section.id }}">
                  {%- form 'product',
                    card_product,
                    id: product_form_id,
                    class: 'form',
                    novalidate: 'novalidate',
                    data-type: 'add-to-cart-form'
                  -%}
                    <input
                      type="hidden"
                      name="id"
                      value="{{ card_product.selected_or_first_available_variant.id }}"
                      disabled
                    >
                    <button
                      id="{{ product_form_id }}-submit"
                      type="submit"
                      name="add"
                      class="custom-icon-btn"
                      aria-haspopup="dialog"
                      aria-labelledby="{{ product_form_id }}-submit title-{{ section_id }}-{{ card_product.id }}"
                      aria-live="polite"
                      data-sold-out-message="true"
                      {% if card_product.available == false or card_product.selected_or_first_available_variant.available == false %}
                        disabled
                      {% endif %}
                    >
                      <svg width="42" height="42" viewBox="0 0 56 56" fill="none" xmlns="http://www.w3.org/2000/svg">
                        <path d="M25.0227 40.2953C26.3037 40.2953 27.3422 39.2568 27.3422 37.9758C27.3422 36.6947 26.3037 35.6562 25.0227 35.6562C23.7416 35.6562 22.7031 36.6947 22.7031 37.9758C22.7031 39.2568 23.7416 40.2953 25.0227 40.2953Z" stroke="#191919" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round"/>
                        <path d="M35.1281 40.2953C36.4092 40.2953 37.4477 39.2568 37.4477 37.9758C37.4477 36.6947 36.4092 35.6562 35.1281 35.6562C33.8471 35.6562 32.8086 36.6947 32.8086 37.9758C32.8086 39.2568 33.8471 40.2953 35.1281 40.2953Z" stroke="#191919" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round"/>
                        <path d="M19.6456 19.5748L22.3865 28.253C22.8079 29.5866 23.0179 30.2535 23.4229 30.7471C23.7774 31.1835 24.2397 31.5203 24.762 31.7289C25.3552 31.9648 26.0533 31.9648 27.4524 31.9648H32.7092C34.1083 31.9648 34.8065 31.9648 35.3983 31.7289C35.922 31.5203 36.3829 31.1835 36.7388 30.7471C37.1424 30.2535 37.3524 29.5866 37.7752 28.253L38.3329 26.4857L38.6602 25.4412L39.1115 24.0094C39.2726 23.4987 39.3111 22.9572 39.2239 22.4289C39.1367 21.9006 38.9263 21.4002 38.6097 20.9683C38.2931 20.5365 37.8793 20.1853 37.4016 19.9432C36.924 19.7011 36.3961 19.5749 35.8606 19.5748H19.6456ZM19.6456 19.5748L19.6306 19.5244C19.573 19.3315 19.5094 19.1405 19.4397 18.9516C19.1636 18.2528 18.6955 17.6464 18.0893 17.2024C17.4832 16.7584 16.7638 16.495 16.0142 16.4425C15.8738 16.4316 15.7197 16.4316 15.4102 16.4316" stroke="#191919" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round"/>
                        <circle cx="30" cy="26" r="1" fill="#191919"/>
                      </svg>
                      {%- render 'loading-spinner' -%}
                    </button>
                  {%- endform -%}
                </product-form>
              {%- endif -%}
            </div>
          {%- endif -%}
        </div>
      </div>
    </div>
  </div>
{%- else -%}
  <div class="card-wrapper product-card-wrapper underline-links-hover">
    <div class="custom-dak-card">
      <div class="custom-dak-image-wrapper">
        {{ 'product-apparel-2' | placeholder_svg_tag: 'placeholder-svg' }}
      </div>
      <div class="custom-dak-bottom">
        <div class="custom-dak-info">
          <h3 class="custom-dak-title">{{ 'onboarding.product_title' | t }}</h3>
