{% comment %}
  Renders a store card with Figma-perfect font and button sizing for desktop.
{% endcomment %}

<style>
  .store-card {
    display: flex;
    flex-direction: column;
    justify-content: flex-start;
    align-items: center;
    width: 100%;
    height: 100%;
    position: relative;
    gap: 16px;
    padding: 24px;
    border: 1px solid rgba(25, 25, 25, 0.08);
    box-sizing: border-box;
    cursor: pointer;
    transition: all 0.3s ease;
  }

  .store-card__image-wrapper {
    flex-grow: 0;
    flex-shrink: 0;
    width: 100%;
    aspect-ratio: 416 / 277;
    overflow: hidden;
  }

  .store-card__image-wrapper img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .store-card__content {
    display: flex;
    flex-direction: column;
    justify-content: flex-start;
    align-items: flex-start;
    width: 100%;
    gap: 12px;
    flex-grow: 1;
  }

  .store-card__title {
    width: 100%;
    font-size: 16px; /* Mobile Default */
    font-weight: 500;
    text-align: left;
    color: var(--color-custom-black);
    margin: 0;
    line-height: 1.2;
    transition: color 0.3s ease;
  }

  .store-card__info-row {
    display: flex;
    justify-content: flex-start;
    align-items: flex-start;
    width: 100%;
    gap: 10px;
  }

  .store-card__icon {
    flex-shrink: 0;
    height: 1em; 
    width: auto; 
    margin-top: 4px;
  }

  .store-card .store-card__text {
    flex-grow: 1;
    font-size: 14px; /* Mobile Default */
    text-align: left;
    color: #4d4d4d;
    margin: 0;
    line-height: 1.4;
    text-decoration: none;
  }

  .store-card a.store-card__text {
    color: #4d4d4d;
    text-decoration: none;
  }

  .view-directions-btn .cta-label {
    font-size: 18px;
  }

  /* --- DESKTOP ONLY ADJUSTMENTS (BASED ON FIGMA) --- */
  @media screen and (768px <= width <= 1023px) {
    .view-directions-btn .cta-label {
      font-size: 14px;
    }
  }

  @media screen and (max-width: 768px) {
    .view-directions-btn .cta-label {
      font-size: 12px;
    }
  }

  @media screen and (min-width: 769px) {
    .store-card__title {
      font-size: 20px; /* Figma: 20px */
    }

    .store-card .store-card__text {
      font-size: 18px; /* Figma: 18px */
    }

    /* Existing Hover Animations */
    .store-card:hover .store-card__title {
      color: var(--color-heading);
    }

    .store-card:hover .cta-snippet-btn {
      background-color: var(--color-primary);
      color: var(--color-custom-black);
      border-color: var(--color-primary);
    }

    .store-card:hover .cta-icon {
      transform: rotate(90deg);
    }
  }

  @media screen and (min-width: 1024px) and (max-width: 1180px) {
    .store-card {
      gap: 10px;
      padding: 14px;
    }

    .store-card__content {
      gap: 7px;
    }

    .store-card__title {
      font-size: 16px;
    }

    .store-card__info-row {
      gap: 10px;
    }

    .store-card__icon {
      margin-top: 2px;
    }

    .store-card .store-card__text {
      font-size: 14px;
    }

    .cta-snippet-btn {
      gap: 7px;
    }

    .featured-stores-header h2 {
      font-size: 46px;
    }

    .featured-stores-header h2 {
      font-size: 36px;
    }

    .view-directions-btn .cta-label {
      font-size: 14px;
    }
  }
    
  @media screen and (min-width: 1181px) and (max-width: 1536px) {
    .featured-stores-header h2 {
      font-size: 40px;
    }

    .store-card {
      gap: 11px;
      padding: 15px;
    }

    .store-card__content {
      gap: 8px;
    }

    .store-card__title {
      font-size: 18px;
    }

    .store-card__info-row {
      gap: 10px;
    }

    .store-card .store-card__text {
      font-size: 16px;
    }

    .featured-stores-section {
      padding: 60px 80px;
    }

    .cta-snippet-btn {
      gap: 8px;
    }

    .view-directions-btn .cta-label {
      font-size: 16px;
    }
  }

</style>

<div class="store-card">
  {%- if store.store_image != blank -%}
    <div class="store-card__image-wrapper">
      <img
        src="{{ store.store_image | image_url: width: 600 }}"
        alt="{{ store.store_name }}"
        loading="lazy"
        width="416"
        height="277"
      >
    </div>
  {%- endif -%}

  <div class="store-card__content">
    <h3 class="store-card__title">{{ store.store_name }}</h3>

    <div class="store-card__info-row">
      <svg class="store-card__icon" viewBox="0 0 12 17" fill="none" xmlns="http://www.w3.org/2000/svg">
