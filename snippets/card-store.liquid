        </svg>
      <p class="store-card__text">{{ store.address }}</p>
    </div>

    <div class="store-card__info-row">
      <svg class="store-card__icon" viewBox="0 0 17 17" fill="none" xmlns="http://www.w3.org/2000/svg">
        <path d="M13.3205 16.4999C12.6233 16.4999 11.6438 16.2477 10.177 15.4284C8.39346 14.4284 7.0139 13.5052 5.23996 11.7362C3.52961 10.0273 2.6973 8.92084 1.53242 6.80153C0.216435 4.40864 0.440766 3.15434 0.691532 2.61827C0.990164 1.97754 1.43097 1.59432 2.00073 1.21396C2.32435 1.00197 2.66682 0.82025 3.02379 0.671099C3.05952 0.655742 3.09274 0.641099 3.12239 0.627884C3.29921 0.548241 3.56712 0.427882 3.90648 0.556455C4.13295 0.641456 4.33513 0.815387 4.65163 1.12789C5.30069 1.7679 6.18766 3.19327 6.51487 3.89328C6.73455 4.36507 6.87994 4.6765 6.8803 5.02579C6.8803 5.43473 6.67454 5.75009 6.42485 6.09045C6.37805 6.15438 6.33161 6.21545 6.2866 6.27474C6.01476 6.63188 5.95511 6.7351 5.9944 6.91939C6.07406 7.28975 6.66811 8.39226 7.64438 9.3662C8.62065 10.3401 9.69159 10.8966 10.0634 10.9759C10.2556 11.0169 10.361 10.9548 10.7297 10.6734C10.7825 10.633 10.8368 10.5912 10.8936 10.5494C11.2744 10.2662 11.5752 10.0659 11.9746 10.0659H11.9767C12.3243 10.0659 12.6218 10.2166 13.1148 10.4651C13.7578 10.7894 15.2263 11.6648 15.8704 12.3145C16.1836 12.6302 16.3583 12.8316 16.4437 13.0577C16.5723 13.398 16.4512 13.6648 16.3722 13.8434C16.359 13.873 16.3444 13.9055 16.329 13.9416C16.1787 14.2979 15.9958 14.6396 15.7828 14.9623C15.4031 15.5302 15.0184 15.9699 14.3761 16.2688C14.0463 16.4248 13.6854 16.5038 13.3205 16.4999Z" stroke="#4D4D4D"/>
      </svg>
      <a href="tel:{{ store.phone_number }}" class="store-card__text store-card__link">{{ store.phone_number }}</a>
    </div>
  </div>

  <a
    href="{{ store.map_url }}"
    target="_blank"
    class="cta-snippet-btn view-directions-btn"
    style="
      width: 100%;
      justify-content: center;
    "
  >
    <span class="cta-label">View Directions</span>

    <svg class="cta-icon" width="24" height="24" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
      <path d="M7.70684 17.5785C5.82572 15.6973 3.87406 13.8925 1.99883 11.9996L12.1451 2L22.1797 12.1583L12.1451 21.9992C11.7924 22.0639 8.2653 18.1428 7.70684 17.5843V17.5785Z" stroke="currentColor" stroke-miterlimit="10"/>
      <path d="M12.1551 10.4974C10.5033 10.4974 10.4974 13.0664 12.1551 13.0664C13.8129 13.0664 13.8129 10.4974 12.1551 10.4974Z" fill="currentColor"/>
    </svg>
  </a>
</div>