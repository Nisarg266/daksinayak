<style>
    .custom-tab-section {
        width: 100%;
        height: 100px;
        position: relative;
    }

    .tabs-background {
        width: 100%;
        height: 100%;
    }

    .tabs-items {
        position: absolute;
        top: 50%;
        left: 50%;
        transform: translate(-50%, -50%);
        display: flex;
        flex-direction: row;
        gap: 32px;
        align-items: normal;
    }

    .tab-item {
        background-color: transparent;
        border: none;
        letter-spacing: 0.08em;
        font-size: 18px;
        padding: 0 !important;
        color: #19191999;
        cursor: pointer;
    }

    .tab-divider {
        display: block;
        height: 18px;
        width: 0.5px;
        background-color: var(--color-custom-black);
    }

    .tab-item:hover {
        color: var(--color-heading);
    }

</style>

<div class="container">
  <div class="custom-tab-section">
    <img
      class="tabs-background"
      src="{{ 'menu_background.svg' | asset_url }}"
      alt="Tabs background image"
      width="1440"
      height="100"
    >
    <div class="tabs-items">
      <button class="tab-item">ALL</button>
      <span class="tab-divider"></span>
      <button class="tab-item">MASALAS</button>
      <span class="tab-divider"></span>
      <button class="tab-item">READY TO EAT</button>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Custom tabs",
  "settings": [],
  "presets": [
    {
      "name": "Custom tabs"
    }
  ]
}
{% endschema %}
