{% comment %}
  DAKSHINAYAN MENU - HYBRID (Desktop Tabs + Mobile Sticky Drawer)
{% endcomment %}

<style>
  :root {
    --color-primary: #FFCB05;
    --color-off-white: #F1EAD7;
    --color-heading: #E8202B;
    --color-custom-black: #191919;
    --color-custom-gray: #4D4D4D;
  }

  /* --- DESKTOP TABS STYLING --- */
  .dakshinayan-tabs-wrapper {
    width: 100%;
    max-width: 1440px;
    margin: 80px auto 0;
    position: relative;
    height: 134px;
    overflow: hidden;
    background-color: var(--color-off-white);
  }

  .bg-wrapper {
    width: 100%;
    height: 100%;
    object-fit: contain;
    z-index: 1;
    display: flex;
    flex-direction: row;
  }

  .middle-block {
    flex: 1;
    height: 100%;
    width: 100%;
    border-top: 1px solid var(--color-heading);
    border-bottom: 1px solid var(--color-heading);
    margin: 0;
  }

  .tabs-content-container {
    position: relative;
    z-index: 2;
    height: 100%;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    padding: 16px 80px;
    gap: 16px;
  }

  .tabs-row {
    display: flex;
    align-items: center;
    gap: 32px;
    height: 50px;
  }

  .tab-button {
    background: none;
    border: none;
    font-size: 18px;
    text-transform: uppercase;
    color: rgba(25, 25, 25, 0.5);
    cursor: pointer;
    letter-spacing: 0.08em;
    white-space: nowrap;
    transition: color 0.2s ease;
    padding: 10.5px 8px;
  }

  .tab-button:hover,
  .tab-button.active {
    color: var(--color-heading);
  }

  .tab-sep {
    width: 1px;
    height: 20px;
    background-color: rgba(25, 25, 25, 0.5);
    flex-shrink: 0;
  }

 
  .menu-note-container {
    max-width: 1440px;
    margin: 0 auto;
    display: flex;
    justify-content: flex-end;
  }

  .menu-note-text {
    font-size: 16px;
    text-align: end;
    color: var(--color-custom-gray);
    margin: 16px 0 0 0;
    max-width: 1440px;
    padding-right: 75px;
  }

  .menu-note-label {
    font-weight: 700;
  }

  .menu-grid-container {
    max-width: 1440px;
    margin: 48px auto;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(342px, 1fr));
    gap: 24px;
    justify-items: center;
  }

  /* --- CARD FIX: Hide by default to prevent flash --- */
  .menu-card {
    display: none;
    /* CHANGED from flex to none */
    flex-direction: column;
    width: 342px;
    padding: 16px;
    gap: 16px;
    border: 1px solid rgba(25, 25, 25, 0.08);
    background: var(--color-off-white);
  }

  /* --- CARD FIX: New class to show items --- */
  .menu-card.show {
    display: flex;
  }

  .menu-card img {
    width: 310px;
    height: 207px;
    object-fit: cover;
    flex-shrink: 0;
  }

  .menu-card-info {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .menu-card-title {
    font-size: 24px;
    font-weight: 500;
    color: var(--color-custom-black);
    margin: 0;
  }

  .menu-card-desc {
    font-size: 18px;
    font-weight: 300;
    color: rgba(25, 25, 25, 0.5);
    margin: 0;
    line-height: 1.4;
  }

  /* --- MOBILE STICKY MENU STYLING --- */
  #mobileMenuWrapper {
    display: flex;
    position: fixed;
    bottom: 30px;
    right: 20px;
    z-index: 2;
    flex-direction: column;
    align-items: flex-end;
    gap: 15px;
    pointer-events: none;
  }

  .sticky-menu-btn {
    background: var(--color-primary);
    box-shadow: 0px 6px 15px rgba(0, 0, 0, 0.15);
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    border: none;
    transition: transform 0.2s ease;
    pointer-events: auto;
    padding: 18px 18px;
  }

  .sticky-menu-btn:active {
    transform: scale(0.95);
  }

  .sticky-menu-btn span {
    font-size: 18px;
    font-weight: 500;
    color: var(--color-custom-black);
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .mobile-menu-drawer {
    width: 263px;
    background: var(--color-primary);
    box-shadow: 0 4px 20px 10px rgba(0, 0, 0, 0.1);
    opacity: 0;
    transform: translateY(20px);
    pointer-events: none;
    transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
    overflow-y: auto;
    max-height: 400px;
  }

  #mobileMenuWrapper.open .mobile-menu-drawer {
    opacity: 1;
    transform: translateY(0);
    pointer-events: auto;
  }

  .drawer-item {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 12px 20px;
    cursor: pointer;
    border-bottom: 1px solid rgba(0, 0, 0, 0.05);
  }

  .drawer-item:last-child {
    border-bottom: none;
  }

  .drawer-item p {
    margin: 0;
    font-size: 18px;
    color: rgba(25, 25, 25, 0.6);
  }

  /* --- DIAMOND ICON STYLING --- */
  .drawer-item svg {
    width: 16px;
    height: 16px;
    flex-shrink: 0;
  }

  .drawer-item svg path:nth-of-type(1) {
    stroke: #4D4D4D;
    fill: transparent;
    transition: all 0.2s ease;
  }

  .drawer-item svg path:nth-of-type(2) {
    fill: #4D4D4D;
    transition: all 0.2s ease;
  }

  /* Active State */
  .drawer-item.active p {
    color: var(--color-heading);
  }

  .drawer-item.active svg path:nth-of-type(1) {
    stroke: var(--color-heading);
    fill: var(--color-heading);
  }

  .drawer-item.active svg path:nth-of-type(2) {
    fill: var(--color-off-white);
  }

  .webkit-center {
    text-align: -webkit-center !important;
  }

  .svg-class-left {
    background-color: #F1EAD7;
    height: 100%;
    width: auto;
    flex-shrink: 0;
  }

  .svg-class-right {
    background-color: #F1EAD7;
    height: 100%;
    width: auto;
    flex-shrink: 0;
  }

  .svg-css-left {
    flex-shrink: 0;
    margin-right: -10px;
  }

  .svg-css-right {
    flex-shrink: 0;
    margin-left: -10px;
  }

  /* --- MEDIA QUERIES --- */
  @media (max-width: 1023px) {
    .dakshinayan-tabs-wrapper {
      display: none !important;
    }

    #mobileMenuWrapper {
      display: flex !important;
    }

    .menu-note-container {
      padding-right: 20px;
      justify-content: center;
    }

    .menu-note-text {
      padding-right: 0;
      text-align: center;
      margin: 36px 0 0 0;
    }

    .sticky-menu-btn span {
      font-size: 14px;
    }

    .mobile-menu-drawer {
      width: 243px;
    }

    .drawer-item {
      padding: 8px 20px;
    }

    .drawer-item p {
      font-size: 16px;
    }

    /* --- MOBILE 2-COLUMN GRID FIX START --- */
    .menu-grid-container {
      grid-template-columns: repeat(2, 1fr);
      padding: 0 12px;
      gap: 10px;
      margin: 8px auto;
    }

    .menu-card {
      width: 100%;
      min-width: 0;
      padding: 8px;
    }

    .menu-card img {
      width: 100%;
      height: auto;
      aspect-ratio: 310 / 207;
    }

    .menu-card-title {
      font-size: 16px;
    }

    .menu-card-desc {
      font-size: 13px;
    }

    /* --- MOBILE 2-COLUMN GRID FIX END --- */

  }

  @media screen and (min-width: 1024px) and (max-width: 1180px) {
  .dakshinayan-tabs-wrapper {
    height: 80px;
    max-width: 100%;
    margin: 40px auto 0;
  }

  .svg-css-right {
    margin-left: -6px;
  }

  .svg-css-left {
    margin-right: -6px;
  }

  .tabs-content-container {
    padding: 8px 30px;
    gap: 8px;
  }

  .tabs-row {
    gap: 10px;
    height: 30px;
  }

  .tab-button {
    font-size: 14px;
    padding: 4px 6px;
  }

  .tab-sep {
    height: 12px;
  }

  .menu-grid-container {
    max-width: 100%;
    grid-template-columns: repeat(3, 1fr);
    gap: 12px;
    padding: 0 20px;
    margin: 24px auto;
  }

  .menu-card {
    width: 100%;
    padding: 10px;
    gap: 10px;
  }

  .menu-card img {
    width: 100%;
    height: auto;
  }

  .menu-card-title {
    font-size: 18px;
  }

  .menu-card-desc {
    font-size: 14px;
  }

  .menu-note-container {
    max-width: 850px;
  }

  .menu-note-text {
    font-size: 12px;
    text-align: end;
    max-width: 850px;
    padding-right: 45px;
  }

  #mobileMenuWrapper {
    bottom: 18px;
    right: 12px;
    gap: 9px;
  }

  .mobile-menu-drawer {
    width: 158px;
    max-height: 240px;
  }

  .drawer-item {
    padding: 7px 12px;
  }

  .drawer-item p {
    font-size: 14px;
  }

  .drawer-item svg {
    width: 10px;
    height: 10px;
  }
  .sticky-menu-btn {
    padding: 10px 12px;
  }
  .sticky-menu-btn span {
    font-size: 14px;
  }
}

@media screen and (min-width: 1181px) and (max-width: 1536px) {
  .sticky-menu-btn {
    padding: 12px 16px;
  }
  .dakshinayan-tabs-wrapper {
    height: 108px;
    max-width: 1280px;
    margin: 60px auto 0;
  }

  .tabs-content-container {
    padding: 12px 60px;
    gap: 12px;
  }

  .tabs-row {
    gap: 24px;
    height: 40px;
  }

  .tab-button {
    font-size: 14px;
    padding: 8px 6px;
  }

  .tab-sep {
    height: 16px;
  }

  .menu-grid-container {
    max-width: 1280px;
    grid-template-columns: repeat(4, 1fr);
    gap: 18px;
    margin: 36px auto;
    padding: 0 20px;
  }

  .menu-card {
    width: 100%;
    padding: 13px;
    gap: 13px;
  }

  .menu-card img {
    width: 100%;
    height: auto;
  }

  .menu-card-title {
    font-size: 19px;
  }

  .menu-card-desc {
    font-size: 14px;
  }

  .menu-note-container {
    max-width: 1280px;
  }

  .menu-note-text {
    font-size: 12px;
    text-align: end;
    max-width: 1280px;
    padding-right: 60px;
  }

  #mobileMenuWrapper {
    bottom: 24px;
    right: 16px;
    gap: 12px;
  }

  .sticky-menu-btn span {
    font-size: 14px;
  }

  .mobile-menu-drawer {
    width: 210px;
    max-height: 320px;
  }

  .drawer-item {
    padding: 10px 16px;
  }

  .drawer-item p {
    font-size: 14px;
  }

  .drawer-item svg {
    width: 13px;
    height: 13px;
  }
}
</style>

