<div id="mobileMenuWrapper">
 <div class="mobile-menu-drawer">
  <div class="drawer-item active" onclick="mobileFilter('APPETISERS', this)"><p>Appetizers</p>{% render 'icon-menu-arrow' %}</div>
  <div class="drawer-item" onclick="mobileFilter('IDLI', this)"><p>Idli</p>{% render 'icon-menu-arrow' %}</div>
  <div class="drawer-item" onclick="mobileFilter('VADAI', this)"><p>Vadai</p>{% render 'icon-menu-arrow' %}</div>
  <div class="drawer-item" onclick="mobileFilter('DOSAI', this)"><p>Dosai</p>{% render 'icon-menu-arrow' %}</div>
  <div class="drawer-item" onclick="mobileFilter('OOTHAPPAMS', this)"><p>Oothappams</p>{% render 'icon-menu-arrow' %}</div>
  <div class="drawer-item" onclick="mobileFilter('SEVAI', this)"><p>Sevai</p>{% render 'icon-menu-arrow' %}</div>
  <div class="drawer-item" onclick="mobileFilter('SADAM', this)"><p>Sadam</p>{% render 'icon-menu-arrow' %}</div>
  <div class="drawer-item" onclick="mobileFilter('WEEKLY SPECIALS', this)"><p>Weekly Specials</p>{% render 'icon-menu-arrow' %}</div>
  <div class="drawer-item" onclick="mobileFilter('DAKSHINAYAN SPECIALS', this)"><p>Dakshinayan Specials</p>{% render 'icon-menu-arrow' %}</div>
  <div class="drawer-item" onclick="mobileFilter('SWEET DISHES', this)"><p>Sweet Dishes</p>{% render 'icon-menu-arrow' %}</div>
  <div class="drawer-item" onclick="mobileFilter('BEVERAGES', this)"><p>Beverages</p>{% render 'icon-menu-arrow' %}</div>
 </div>

 <button class="sticky-menu-btn" onclick="toggleMobileMenu()">
  <span>MENU</span>
 </button>
</div>

<div class="container webkit-center">
 <p class="menu-note-text"><span class="menu-note-label">Note:</span> Menu offerings may differ by restaurant location.</p>
</div>

<div class="menu-grid-container" id="menu-grid">
  {%- paginate shop.metaobjects.menu_item.values by 250 -%}
    {%- for item in shop.metaobjects.menu_item.values -%}
      {%- assign cat = item.category | upcase | strip -%} 
      
      <div class="menu-card" data-category="{{ cat }}">
        {%- if item.image -%}
          <img src="{{ item.image | image_url: width: 620 }}" alt="{{ item.name }}" loading="lazy" width="310" height="207">
        {%- endif -%}
        <div class="menu-card-info">
          <h3 class="menu-card-title">{{ item.name }}</h3>
          <p class="menu-card-desc">{{ item.description }}</p>
        </div>
      </div>
    {%- endfor -%}
  {%- endpaginate -%}
</div>

<script>
 // Move Mobile Menu to Body
 document.addEventListener('DOMContentLoaded', () => {
  const mobileMenu = document.getElementById('mobileMenuWrapper');
  if (mobileMenu) {
   document.body.appendChild(mobileMenu);
  }
  
  // Set default active tab and run filter immediately
  const activeBtn = document.querySelector('.tab-button.active');
  if (activeBtn) filterMenu('APPETISERS', activeBtn);

 });

 // Desktop Filter Logic
 function filterMenu(category, el) {
  if(el) {
    document.querySelectorAll('.tab-button').forEach(btn => btn.classList.remove('active'));
    el.classList.add('active');
  }

  const items = document.querySelectorAll('.menu-card');
  const selectedCat = category.toUpperCase().trim();

  items.forEach(item => {
   const itemCat = item.getAttribute('data-category');
   
   if (itemCat === selectedCat || selectedCat === 'ALL') {
    item.classList.add('show'); // ADD class to show
   } else {
    item.classList.remove('show'); // REMOVE class to hide
   }
  });
 }

 // Mobile Menu Logic
 function toggleMobileMenu() {
  const wrapper = document.getElementById('mobileMenuWrapper');
  wrapper.classList.toggle('open');
 }

 function mobileFilter(category, el) {
  // 1. Filter Grid
  filterMenu(category, null);

  // 2. Update Mobile UI
  document.querySelectorAll('.drawer-item').forEach(item => item.classList.remove('active'));
  el.classList.add('active');

  // 3. Close Drawer
  toggleMobileMenu();
  
  // 4. Scroll to grid
  const grid = document.getElementById('menu-grid');
  if(grid) {
   const yOffset = -100; 
   const y = grid.getBoundingClientRect().top + window.pageYOffset + yOffset;
   window.scrollTo({top: y, behavior: 'smooth'});
  }
 }
 
 // Close menu when clicking outside
 document.addEventListener('click', function(event) {
  const wrapper = document.getElementById('mobileMenuWrapper');
  if (wrapper) {
   const isClickInside = wrapper.contains(event.target);
   if (!isClickInside && wrapper.classList.contains('open')) {
    toggleMobileMenu();
   }
  }
 });
</script>