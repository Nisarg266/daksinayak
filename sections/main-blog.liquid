{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: 80px;
    padding-bottom: 120px;
    background-color: {{ section.settings.bg_color }};
  }

  /* Desktop Header Styling */
  .job-header {
    text-align: center;
    margin-bottom: 60px;
    max-width: 600px;
    margin-left: auto;
    margin-right: auto;
  }

  .job-header h1 {
    font-size: 56px;
    color: #E8202B;
    margin: 0 0 16px 0;
    line-height: 1.1;
    font-weight: 400;
  }

  .job-header p {
    font-size: 18px;
    color: #4D4D4D;
    margin: 0;
    line-height: 1.5;
  }

  /* Job List Styling */
  .job-list {
    display: flex;
    flex-direction: column;
    gap: 24px;
  }

  /* Individual Job Card - DESKTOP DEFAULT */
  .job-card {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    padding: 24px;
    border: 1px solid rgba(25, 25, 25, 0.08);
    background-color: transparent;
    transition: all 0.3s ease;
    text-decoration: none;
    position: relative;
  }

  .job-card:hover {
    border-color: rgba(25, 25, 25, 0.2);
    background-color: rgba(25, 25, 25, 0.02);
  }

  /* Left Side: Info */
  .job-info {
    display: flex;
    flex-direction: column;
    gap: 12px;
    flex: 1; /* Allows it to take available space */
  }

  .job-title {
    font-size: 32px;
    color: #191919;
    margin: 0;
    font-weight: 400;
  }

  .job-meta-row {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 24px;
  }

  .job-meta-item {
    display: flex;
    align-items: center;
    gap: 8px;
    color: #4D4D4D;
    font-size: 14px;
  }

  .job-description {
    font-size: 18px;
    color: #4D4D4D;
    margin: 0;
    line-height: 1.5;
    max-width: 1047px;
    letter-spacing: 0.1px;
  }

  /* Right Side: Button */
  .job-action {
    display: flex;
    align-items: center;
    height: 100%;
    align-self: center;
    /* Added min-width to prevent button squishing on mid-sized screens */
    flex-shrink: 0;
    margin-left: 24px;
  }

  .apply-btn {
    display: inline-flex;
    align-items: center;
    gap: 12px;
    padding: 9px 30px;
    border: 1px solid #191919;
    color: #191919;
    background-color: transparent;
    font-size: 20px;
    font-weight: 500;
    text-decoration: none;
    transition: all 0.3s ease;
    cursor: pointer;
    white-space: nowrap;
  }

  .apply-btn svg {
    display: block;
    transition: transform 0.3s ease;
  }

  /* =========================================
     MOBILE & TABLET RESPONSIVENESS
     (Shifting layout here, leaving Desktop untouched above)
     ========================================= */

  @media screen and (max-width: 990px) {
    .section-{{ section.id }}-padding {
      padding-top: 40px;
      padding-bottom: 60px;
    }

    .job-header h1 {
      font-size: 36px; /* Scaled down from 40px for better fit */
    }

    .job-header {
      margin-bottom: 40px;
      padding: 0 16px;
    }

    /* Force Column Layout */
    .job-card {
      flex-direction: column;
      align-items: flex-start; /* Reset alignment */
      gap: 0; /* Managed by children margins */
      padding: 20px;
    }

    .job-info {
      width: 100%;
      gap: 16px;
    }

    .job-title {
      font-size: 24px; /* Smaller title for mobile */
      line-height: 1.3;
    }

    .job-meta-row {
      gap: 16px; /* Tighter gap */
    }

    .job-description {
      font-size: 16px; /* Readable mobile body text */
      max-width: 100%;
    }

    /* Move Button to Bottom & Full Width */
    .job-action {
      width: 100%;
      margin-left: 0;
      margin-top: 24px; /* Space between text and button */
      height: auto;
    }

    .apply-btn {
      width: 100%;
      justify-content: center;
      padding: 8px 20px;
      font-size: 18px
    }
  }

  /* Desktop Hover Effects - MOVED OUTSIDE */
  @media screen and (min-width: 991px) {
    .apply-btn:hover {
      background-color: var(--color-primary);
      color: var(--color-custom-black);
      border: 1px solid var(--color-primary);
    }

    .apply-btn:hover svg {
      transform: rotate(90deg);
    }
  }
{%- endstyle -%}

{%- paginate blog.articles by 50 -%}
  <div class="main-blog section-{{ section.id }}-padding">
    <div class="container">
      <div class="job-header">
        <h1 class="font-tasman-regular">Current Job Openings</h1>
        <p>Explore exciting career opportunities across various departments</p>
      </div>

      <div class="job-list">
        {%- for article in blog.articles -%}
          {%- assign job_file_url = article.metafields.custom.job_pdf.value.url | default: article.url -%}
          
          <a href="{{ job_file_url }}" 
             class="job-card" 
             {% if article.metafields.custom.job_pdf.value.url %} target="_blank" rel="noopener" {% endif %}>
            
            <div class="job-info">
              <h2 class="job-title">{{ article.title }}</h2>

              <div class="job-meta-row">
                {%- if article.metafields.custom.location != blank -%}
                  <div class="job-meta-item">
                    <svg width="16" height="16" viewBox="0 0 16 16" fill="none" xmlns="http://www.w3.org/2000/svg">
                      <path d="M8.0026 7.66732C7.56058 7.66732 7.13665 7.49172 6.82409 7.17916C6.51153 6.8666 6.33594 6.44268 6.33594 6.00065C6.33594 5.55862 6.51153 5.1347 6.82409 4.82214C7.13665 4.50958 7.56058 4.33398 8.0026 4.33398C8.44463 4.33398 8.86855 4.50958 9.18112 4.82214C9.49368 5.1347 9.66927 5.55862 9.66927 6.00065C9.66927 6.21952 9.62616 6.43625 9.5424 6.63846C9.45865 6.84067 9.33588 7.0244 9.18112 7.17916C9.02635 7.33393 8.84262 7.45669 8.64041 7.54045C8.4382 7.62421 8.22147 7.66732 8.0026 7.66732ZM8.0026 1.33398C6.76493 1.33398 5.57794 1.82565 4.70277 2.70082C3.8276 3.57599 3.33594 4.76297 3.33594 6.00065C3.33594 9.50065 8.0026 14.6673 8.0026 14.6673C8.0026 14.6673 12.6693 9.50065 12.6693 6.00065C12.6693 4.76297 12.1776 3.57599 11.3024 2.70082C10.4273 1.82565 9.24028 1.33398 8.0026 1.33398Z" stroke="#4D4D4D"/>
                    </svg>
                    {{ article.metafields.custom.location }}
                  </div>
                {%- endif -%}

                {%- if article.metafields.custom.type != blank -%}
                  <div class="job-meta-item">
                    <svg width="16" height="16" viewBox="0 0 16 16" fill="none" xmlns="http://www.w3.org/2000/svg">
                      <g clip-path="url(#clip0_37_17163)">
                        <path d="M1.33594 8.00065C1.33594 4.31865 4.3206 1.33398 8.0026 1.33398C11.6846 1.33398 14.6693 4.31865 14.6693 8.00065C14.6693 11.6827 11.6846 14.6673 8.0026 14.6673C4.3206 14.6673 1.33594 11.6827 1.33594 8.00065Z" stroke="#4D4D4D" stroke-linecap="square"/>
                        <path d="M8 4.33398V8.00065L10 10.0007" stroke="#4D4D4D" stroke-linecap="square"/>
                      </g>
                    </svg>
                    {{ article.metafields.custom.type }}
                  </div>
                {%- endif -%}

                {%- if article.metafields.custom.experience != blank -%}
                  <div class="job-meta-item">
                    <svg width="13" height="14" viewBox="0 0 13 14" fill="none" xmlns="http://www.w3.org/2000/svg">
                      <g clip-path="url(#clip0_37_17172)">
                        <path d="M9.03516 9.43457L9.03613 9.43555C10.613 9.94281 11.751 11.4173 11.751 13.1592C11.751 13.3467 11.599 13.4988 11.4121 13.499H0.84082C0.654854 13.499 0.500977 13.3451 0.500977 13.1592C0.500977 11.4171 1.63969 9.94271 3.21387 9.43555L3.21484 9.43457C3.28769 9.41098 3.40153 9.42923 3.5 9.53418H3.50098L5.44238 11.5986C5.8121 11.9916 6.43796 11.9917 6.80762 11.5986L8.74902 9.53418C8.84749 9.42923 8.96231 9.41098 9.03516 9.43457ZM1.23828 6.49902H0.514648L0.875977 4.69043L1.23828 6.49902ZM3.12598 2.40234L2.72461 2.32227L1.41211 2.05957L0.813477 1.93945V1.9668L0.602539 1.89453C0.543674 1.87402 0.501138 1.81711 0.500977 1.74902C0.500977 1.69363 0.531421 1.64359 0.576172 1.61621L0.625 1.59668H0.626953L6.0957 0.50293C6.11567 0.499422 6.13627 0.499476 6.15625 0.50293L11.625 1.59668H11.627C11.6975 1.61054 11.751 1.67509 11.751 1.74902C11.7508 1.82279 11.6974 1.88655 11.627 1.90039L11.625 1.90137L9.52734 2.32227L9.12598 2.40234V4.37402C9.12577 6.0309 7.78291 7.37402 6.12598 7.37402C4.46916 7.37389 3.12619 6.03082 3.12598 4.37402V2.40234Z" stroke="#4D4D4D"/>
                      </g>
                    </svg>
                    {{ article.metafields.custom.experience }}
                  </div>
                {%- endif -%}
              </div>

              <p class="job-description">
                {{ article.metafields.custom.short_description | strip_html | truncate: 130 }}
              </p>
            </div>

            <div class="job-action">
              <span class="apply-btn">
                Apply Now
                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                  <path d="M7.70684 17.5785C5.82572 15.6973 3.87406 13.8925 1.99883 11.9996L12.1451 2L22.1797 12.1583L12.1451 21.9992C11.7924 22.0639 8.2653 18.1428 7.70684 17.5843V17.5785Z" stroke="currentColor" stroke-miterlimit="10"/>
                  <path d="M12.1551 10.4974C10.5033 10.4974 10.4974 13.0664 12.1551 13.0664C13.8129 13.0664 13.8129 10.4974 12.1551 10.4974Z" fill="currentColor"/>
                </svg>
              </span>
            </div>
          </a>
        {%- endfor -%}
      </div>

      {%- if paginate.pages > 1 -%}
        {%- render 'pagination', paginate: paginate -%}
      {%- endif -%}
    </div>
  </div>
{%- endpaginate -%}

{% schema %}
{
  "name": "t:sections.main-blog.name",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#F1EAD7"
    },
    {
      "type": "header",
      "content": "t:sections.all.padding.section_padding_heading"
    }
  ]
}
{% endschema %}
