{% comment %}
  Section: Custom Banner (Our Story)
  Design: Full-width yellow banner with centered red text and flanking Rangoli patterns.
{% endcomment %}

<style>
  .custom-banner-section {
    width: 100%;
    min-height: 320px; /* Desktop height */
    background-color: var(--color-primary); /* Yellow */
    border-top: 1px solid var(--color-heading); /* Red border */
    position: relative;
    overflow: hidden;
    display: flex;
    align-items: center;
    justify-content: center;
    font-family: var(--font-body-family);
  }

  /* --- TEXT --- */
  .banner-text {
    font-size: 56px;
    font-weight: 600;
    text-align: center;
    color: var(--color-heading);
    margin: 0;
    z-index: 2; /* Ensure text is above patterns */
    padding: 0 20px;
    line-height: 1.2;
  }

  /* --- PATTERNS --- */
  .banner-pattern {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    width: 133px; /* Based on SVG viewbox */
    height: 266px;
    z-index: 1;
    pointer-events: none;
  }

  .banner-pattern svg {
    width: 100%;
    height: 100%;
    display: block;
  }

  .pattern-left {
    left: 0;
  }

  .pattern-right {
    right: 0;
    transform: translateY(-50%) scaleX(-1); /* Mirror the left pattern for the right side */
  }

  /* --- RESPONSIVE --- */
  @media screen and (max-width: 1440px) {
    .banner-text {
      font-size: 48px;
    }
  }

  @media screen and (max-width: 1024px) {
    .custom-banner-section {
      min-height: 250px;
    }

    .banner-text {
      font-size: 40px;
    }
  }

  @media screen and (max-width: 768px) {
    .custom-banner-section {
      min-height: 150px;
    }

    .banner-text {
      font-size: 24px;
    }

    /* Hide patterns on mobile to prevent crowding */
    .banner-pattern {
      display: none;
    }
  }
</style>

