{% comment %}
  Section: Custom Footer
  Design: 4-Column Grid with Flanking Rangoli Patterns & Social Icons
{% endcomment %}

<style>
  .custom-footer-section {
    background-color: #FFCB05; /* Exact yellow from Figma */
    color: #191919;
    padding: 60px 0 0 0; /* 0 bottom padding to let copyright sit flush if needed */
    width: 100%;
    position: relative;
    overflow: hidden;
    border-top: 1px solid #e8202b; /* Top Red Border */
    font-family: var(--font-body-family);
  }

  .footer-wrapper {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    max-width: 1440px;
    margin: 0 auto;
    position: relative;
    padding: 0 20px;
    padding-bottom: 40px; /* Space before bottom bar */
  }

  /* --- SIDE PATTERNS --- */
  .footer-pattern {
    width: 130px; /* Adjusted size */
    flex-shrink: 0;
    margin-top: 20px;
  }

  .footer-pattern svg {
    width: 100%;
    height: auto;
  }

  /* Hide patterns on mobile to save space */
  @media screen and (max-width: 1200px) {
    .footer-pattern { display: none; }
  }

  /* --- CENTRAL CONTENT --- */
  .footer-content {
    flex-grow: 1;
    display: grid;
    grid-template-columns: repeat(4, 1fr); /* 4 Columns */
    gap: 40px;
    max-width: 900px;
    margin: 0 auto;
    text-align: left;
  }

  @media screen and (max-width: 768px) {
    .footer-content {
      grid-template-columns: 1fr; /* Stack on mobile */
      text-align: center;
      gap: 30px;
    }
  }

  /* --- TYPOGRAPHY --- */
  .footer-col h3 {
    color: #E8202B; /* Red Heading */
    font-size: 18px;
    font-weight: 500;
    margin-bottom: 24px;
    margin-top: 0;
    line-height: 1.2;
  }

  .footer-menu {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .footer-menu li a {
    text-decoration: none;
    color: #191919;
    font-size: 16px;
    transition: opacity 0.2s;
  }

  .footer-menu li a:hover {
    opacity: 0.7;
    color: #E8202B;
  }

  /* --- SOCIAL ICONS --- */
  .social-icons-wrapper {
    margin-top: 16px;
  }

  @media screen and (max-width: 768px) {
    .social-icons-wrapper {
      display: flex;
      justify-content: center;
    }
  }

  /* --- BOTTOM BAR --- */
  .footer-bottom {
    max-width: 1082px;
    margin: 0 auto;
    border-top: 0.5px solid #E8202B; /* Thin red line */
    padding: 24px 20px;
    display: flex;
    justify-content: space-between;
    align-items: center;
    font-size: 14px;
    color: #191919;
  }

  .footer-designed-by {
    display: flex;
    align-items: center;
    gap: 8px;
  }

  @media screen and (max-width: 768px) {
    .footer-bottom {
      flex-direction: column;
      gap: 16px;
      text-align: center;
    }
  }
</style>

<footer class="custom-footer-section">
