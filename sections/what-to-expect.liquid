<style>
  .wte-container {
    max-width: 1440px;
    margin: 60px auto;
    padding: 0 20px;
    font-family: sans-serif;
  }

  .wte-heading {
    color: #e8202b;
    font-size: 56px;
    text-align: center;
    margin-bottom: 50px;
    font-weight: bold;
  }

  .wte-cards-wrapper {
    display: flex;
    gap: 24px;
    height: 398px;
    justify-content: center;
  }

  .wte-card {
    flex: 1;
    position: relative;
    border: 1px solid rgba(25,25,25,0.08);
    overflow: hidden;
    cursor: pointer;
    transition: flex 2s cubic-bezier(0.25, 0.1, 0.25, 1), background-color 2s ease;
    border-radius: 4px;
  }

  .wte-card.active {
    flex: 2.07;
    background-color: #ffcb05;
    border-color: #ffcb05;
  }

  .wte-content {
    position: absolute;
    bottom: 28px;
    left: 28px;
    width: 340px;
    z-index: 10;
    pointer-events: none;
    transition: all 2s ease;
  }

  .wte-card:not(.active) .wte-content {
    width: auto;
    right: 28px;
  }

  .wte-title {
    font-size: 24px;
    font-weight: 600;
    color: #4d4d4d;
    margin: 0 0 8px 0;
    transition: color 0.4s ease;
  }
  
  .wte-desc {
    font-size: 18px;
    color: #4d4d4d;
    
    opacity: 0;
    transform: translateY(10px);
    max-height: 0;
    margin-top: 0;
    overflow: hidden;
    
    line-height: 1.4;
    max-width: 300px;
    
    transition: all 1.6s ease;
  }

  .wte-card.active .wte-title {
    color: #e8202b;
  }

  .wte-card.active .wte-desc {
    opacity: 1;
    transform: translateY(0);
    max-height: 150px;
    margin-top: 8px;
    transition-delay: 0.4s;
    margin-bottom: 0;
  }

  .wte-food-img {
    position: absolute;
    right: 0;
    top: 45%;
    transform: translateY(-50%);
    width: 340px;
    height: 330px;
    z-index: 5;
    pointer-events: none;
  }

  .wte-food-img img {
    width: 100%;
    height: 100%;
    object-fit: contain;
    transform: translateX(120%) rotate(180deg);
    transition: transform 2s cubic-bezier(0.215, 0.61, 0.355, 1);
    filter: drop-shadow(10px 10px 20px rgba(0,0,0,0.15));
  }

  .wte-card.active .wte-food-img img {
    transform: translateX(0) rotate(0deg); 
  }

  .wte-deco {
    position: absolute;
    width: 140px;
    height: 140px;
    z-index: 1;
    pointer-events: none;
    transition: transform 2s ease;
  }

  .wte-deco svg {
    width: 100%;
    height: 100%;
  }

  .wte-deco-tl {
    top: 0;
    left: 0;
    transform: translate(-100%, -100%);
  }

  .wte-card.active .wte-deco-tl {
    transform: translate(0, 0);
  }

  .wte-deco-br {
    bottom: 0;
    right: 0;
    transform: translate(100%, 100%);
  }

  .wte-card.active .wte-deco-br {
    transform: translate(0, 0);
  }

  /* RESPONSIVE MOBILE STYLES 
    Switches from Flex-width to Fixed-height stacking.
  */
  @media (max-width: 1023px) {
    .wte-heading {
      font-size: 32px;
      margin-bottom: 30px;
    }

    .wte-cards-wrapper {
      flex-direction: column;
      height: auto;
      gap: 15px;
    }

    .wte-desc {
      transition: all 0.8s ease;
    }

    .wte-food-img img {
      width: 200px;
      transition: transform 1.6s cubic-bezier(0.215, 0.61, 0.355, 1);
    }

    .wte-card {
      width: 100%;
      flex: none; /* Disable flex-grow */
      height: 110px; /* Compact height for inactive cards */
      
      /* IMPORTANT: Override desktop transition to animate Height instead of Flex */
      transition: height 1.6s cubic-bezier(0.25, 0.1, 0.25, 1), background-color 1.6s ease;
    }

    .wte-card.active {
      flex: none;
      height: 400px; /* Expanded height for active card */
    }
    
    .wte-content {
      bottom: 20px;
      left: 20px;
      right: 20px;
      width: auto;
      transition: all 0.8s ease;
    }
    
    .wte-title {
        font-size: 20px;
    }

    /* Resize Image for mobile */
    .wte-food-img {
        width: 190px;
        height: 180px;
        top: 40%;
        right: 0px;
    }
    
    /* Resize Deco for mobile */
    .wte-deco {
      width: 90px;
      height: 90px;
      transition: transform 1.6s ease;
    }
  }

  @media screen and (min-width: 1024px) and (max-width: 1180px) {
    .catering-title {
      font-size: 28px;
    }
    
    .catering-description {
      font-size: 14px;
    }

    .wte-cards-wrapper {
      height: 258px;
    }

    .wte-title {
      font-size: 20px;
    }

    .wte-food-img {
      position: absolute;
      right: -10px;
      top: 35%;
      transform: translateY(-50%);
      width: 140px;
      height: auto;
      z-index: 5;
      pointer-events: none;
    }

    .wte-deco {
      width: 80px;
      height: 80px;
    }

    .wte-desc {
      font-size: 14px;
    }

    .wte-container {
      padding: 0 70px;
    }

    .wte-heading {
      font-size: 36px;
    }
  }

  @media screen and (min-width: 1181px) and (max-width: 1536px) {
    .catering-title {
      font-size: 28px;
    }
    
    .catering-description {
      font-size: 14px;
    }

    .wte-cards-wrapper {
      height: 358px;
    }

    .wte-title {
      font-size: 22px;
    }

    .wte-food-img {
      position: absolute;
      right: -10px;
      top: 35%;
      transform: translateY(-50%);
      width: 240px;
      height: auto;
      z-index: 5;
      pointer-events: none;
    }

    .wte-deco {
      width: 130px;
      height: 130px;
    }

    .wte-desc {
      font-size: 16px;
    }

    .wte-container {
      padding: 0 110px;
    }

    .wte-heading {
      font-size: 42px;
    }
  }

</style>

<script>
  document.addEventListener('DOMContentLoaded', function() {
    const sectionContainer = document.querySelector('#wte-section-{{ section.id }}');
    if (!sectionContainer) return;

    const cardsWrapper = sectionContainer.querySelector('.wte-cards-wrapper');
    const cards = sectionContainer.querySelectorAll('.wte-card');
    let autoPlayInterval;
    const delay = 3000;

    // 1. Core Activation Function
    function setActiveCard(cardToActivate) {
      cards.forEach(card => card.classList.remove('active'));
      cardToActivate.classList.add('active');
    }

    // 2. Next Slide Logic
    function nextCard() {
      const activeCard = sectionContainer.querySelector('.wte-card.active');
      let nextSibling = activeCard ? activeCard.nextElementSibling : cards[0];
      
      // If we are at the end, loop back to start
      if (!nextSibling) {
        nextSibling = cards[0];
      }
      
      setActiveCard(nextSibling);
    }

    // 3. AutoPlay Controls
    function startAutoPlay() {
      stopAutoPlay(); // Ensure no duplicates
      autoPlayInterval = setInterval(nextCard, delay);
    }

    function stopAutoPlay() {
      clearInterval(autoPlayInterval);
    }

    // 4. Click Event (Manual Override)
    cards.forEach(card => {
      card.addEventListener('click', function() {
        setActiveCard(this);
        // Reset timer on manual click so it doesn't jump immediately
        // startAutoPlay();
      });
    });

    // 5. Hover Pause Events
    cardsWrapper.addEventListener('mouseenter', stopAutoPlay);
    cardsWrapper.addEventListener('mouseleave', startAutoPlay);

    // Init
    // startAutoPlay();
  });
</script>