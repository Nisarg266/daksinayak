{% schema %}
{
  "name": "What To Expect",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Section Heading",
      "default": "What To Expect"
    }
  ],
  "blocks": [
    {
      "type": "card",
      "name": "Card",
      "limit": 3,
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Authentic South Indian taste"
        },
        {
          "type": "textarea",
          "id": "description",
          "label": "Description",
          "default": "Experience rich, traditional flavors crafted from time-honored recipes."
        },
        {
          "type": "image_picker",
          "id": "custom_image",
          "label": "Custom Image (Optional)",
          "info": "If empty, uses image_1.png, image_2.png based on order."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "What To Expect (Animated)",
      "blocks": [
        {
          "type": "card",
          "settings": {
            "title": "Authentic South Indian taste",
            "description": "Experience rich, traditional flavors crafted from time-honored recipes."
          }
        },
        {
          "type": "card",
          "settings": {
            "title": "Fresh, Pure, Vegetarian",
            "description": "Enjoy wholesome, made-to-order vegetarian dishes using the freshest ingredients."
          }
        },
        {
          "type": "card",
          "settings": {
            "title": "Reliable catering service",
            "description": "On-time delivery and seamless service you can count on for every event."
          }
        }
      ]
    }
  ]
}
{% endschema %}

<div class="wte-container" id="wte-section-{{ section.id }}">
  <h2 class="wte-heading font-tasman-regular">{{ section.settings.heading }}</h2>
  
  <div class="wte-cards-wrapper">
    {% for block in section.blocks %}
      {% assign img_index = forloop.index %}
      {% assign asset_name = 'image_' | append: img_index | append: '.png' %}
      {% assign card_image = asset_name | asset_url %}
      
      {% if block.settings.custom_image != blank %}
        {% assign card_image = block.settings.custom_image | image_url %}
      {% endif %}

      {% comment %} REMOVED onclick="setActiveCard(this)" - Handled in JS now {% endcomment %}
