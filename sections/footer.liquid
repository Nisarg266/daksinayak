{% comment %}
  Section: Custom Footer (Static)
  Source: Converted from Figma Export
{% endcomment %}

<style>
  /* --- BASE VARIABLES --- */
  .custom-footer-section {
    background-color: #FFCB05;
    color: #191919;
    width: 100%;
    border-top: 1px solid #E8202B;
    overflow: hidden;
    font-family: var(--font-body-family);
    position: relative;
  }

  .footer-inner {
    display: flex;
    align-items: center;
    padding: 100px 0 100px;
    width: 100%;
    position: relative;
  }

  /* --- SIDE PATTERNS --- */
  .footer-pattern {
    width: 160px; /* Reduced slightly for better fit */
    flex-shrink: 0;
    margin-top: 20px;
    display: block;
  }

  .footer-pattern svg {
    width: 100%;
    height: auto;
    display: block;
  }

  /* Hide patterns on smaller screens */
  @media screen and (max-width: 1300px) {
    .footer-pattern { display: none; }

    .footer-inner {
      padding: 40px 0 40px
    }
  }

  /* --- CENTER CONTENT GRID --- */
  .footer-grid-container {
    flex-grow: 1;
    max-width: 1082px;
    padding: 0 52px;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .footer-columns {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    width: 100%;
    gap: 20px;
    margin-bottom: 34px;
  }

  /* Mobile/Tablet Responsive */
  @media screen and (max-width: 900px) {
    .footer-columns {
      grid-template-columns: 1fr 1fr; /* 2 cols on tablet */
      gap: 40px 20px;
      text-align: left;
    }
  }

  @media screen and (max-width: 500px) {
    .footer-columns {
      grid-template-columns: 1fr; /* 1 col on mobile */
      text-align: center;
    }
  }

  /* --- COLUMN STYLES --- */
  .footer-col h3 {
    color: #E8202B;
    font-size: 18px;
    margin: 0 0 10px 0;
    line-height: 128%;
  }

  .footer-col {
    justify-self: center;
  }

  .footer-nav {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 6.5px;
  }

  .footer-nav li a,
  .footer-nav li p {
    text-decoration: none;
    color: #191919;
    font-size: 16px;
    margin: 0;
    line-height: 124%;
    transition: opacity 0.2s;
  }

  .footer-nav li a:hover {
    opacity: 0.7;
  }

  /* --- SOCIAL ICONS --- */
  .social-icons-row {
    display: flex;
    gap: 12px;
    margin-top: 16px;
    align-items: center;
  }

  @media screen and (max-width: 500px) {
    .social-icons-row {
      justify-content: center;
    }
  }

  .social-icon-svg {
    display: block;
    transition: transform 0.2s;
  }

  .social-icon-svg:hover {
    transform: scale(1.1);
  }

  /* --- BOTTOM BAR --- */
  .footer-bottom-bar {
    width: 100%;
    border-top: 0.5px solid #E8202B;
    padding-top: 24px;
    display: flex;
    justify-content: space-between;
    align-items: center;
    font-size: 14px;
    color: #191919;
  }

  .designer-credit {
    display: flex;
    align-items: center;
    gap: 8px;
  }

  @media screen and (max-width: 768px) {
    .footer-bottom-bar {
      flex-direction: column;
      gap: 4px;
      text-align: center;
    }
  }

@media screen and (min-width: 1024px) and (max-width: 1180px) {
  .footer-pattern {
    display: block;
    width: auto;
  }
  .footer-pattern svg {
    width: 98px;
    height: 224px;
  }
  
  .footer-inner {
    padding: 40px 0;
  }

  .footer-grid-container {
    padding: 0 30px;
  }

  .footer-col h3 {
    font-size: 14px;
  }

  .footer-nav li a {
    font-size: 12px;
  }

  .footer-bottom-bar {
    font-size: 12px;
  }

  .footer-nav {
    gap: 0;
  }

  .footer-columns {
    margin-bottom: 14px;
  }

  .footer-bottom-bar {
    padding-top: 14px;
  }
}

@media screen and (min-width: 1181px) and (max-width: 1536px) {
  .footer-pattern {
    display: block;
    width: 160px;
  }
  .footer-inner {
    padding: 80px 0;
  }
}
</style>

