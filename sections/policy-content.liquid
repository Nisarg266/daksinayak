{% schema %}
{
  "name": "Policy Content",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "select",
      "id": "content_width",
      "options": [
        { "value": "small", "label": "Narrow (Best for Reading)" },
        { "value": "medium", "label": "Standard" },
        { "value": "large", "label": "Wide" }
      ],
      "default": "small",
      "label": "Content Width"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Top Padding",
      "default": 60
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Bottom Padding",
      "default": 60
    }
  ],
  "presets": [
    {
      "name": "Policy Content"
    }
  ]
}
{% endschema %}

<div class="policy-section page-width page-width--{{ section.settings.content_width }}">
  <div class="policy-container">
    <div class="policy-body rte">
      {%- if policy -%}
        {{ policy.body }}
      {%- else -%}
        {{ page.content }}
      {%- endif -%}
    </div>
  </div>
</div>

<style>
  /* --- Layout --- */
  .policy-section {
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
    padding-left: 20px;
    padding-right: 20px;
    margin: 0 auto;
    background: transparent;
  }

  .page-width--small { max-width: 800px; }
  .page-width--medium { max-width: 1000px; }
  .page-width--large { max-width: 1400px; }

  /* --- Typography & Counter --- */
  .policy-body {
    font-family: var(--font-body-family), system-ui, -apple-system, sans-serif;
    color: #191919;
    line-height: 1.8;
    font-size: 16px;
    counter-reset: policy-counter;
  }

  /* --- H2: Auto-Numbering Heading --- */
  /* Added !important to FORCE the size over theme defaults */
  .policy-body h2 {
    counter-increment: policy-counter;
    display: flex !important;
    align-items: center !important;
    font-family: var(--font-heading-family), serif;
    color: #191919;
    font-size: 22px !important; /* FORCED SIZE */
    font-weight: 600;
    margin-top: 60px;
    margin-bottom: 24px;
    padding-bottom: 12px;
    border-bottom: 1px solid rgba(232, 32, 43, 0.2) !important;
    line-height: 1.3 !important;
  }

  /* The Number Style */
  .policy-body h2::before {
    content: counter(policy-counter, decimal-leading-zero);
    font-family: var(--font-heading-family), serif;
    color: #E8202B;
    font-size: 22px !important; /* FORCED SIZE MATCHING TEXT */
    font-weight: 700;
    margin-right: 12px;
    line-height: 1;
    position: relative;
    top: 0;
  }

  /* --- Subheadings (H3, H4) --- */
  .policy-body h3 {
    font-size: 20px !important;
    color: #191919;
    font-weight: 700;
    margin-top: 32px;
    margin-bottom: 12px;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .policy-body h4, .policy-body strong {
    font-weight: 700;
    color: #191919;
  }

  /* --- Paragraphs --- */
  .policy-body p {
    margin-bottom: 24px;
    color: #4D4D4D;
  }

  /* --- Creative Lists --- */
  .policy-body ul {
    list-style: none !important;
    padding-left: 0 !important;
    margin-bottom: 32px;
  }

  .policy-body ul li {
    position: relative;
    padding-left: 24px;
    margin-bottom: 12px;
    color: #4D4D4D;
    list-style: none !important;
  }

  /* Custom Red Square Bullet */
  .policy-body ul li::before {
    content: "";
    width: 6px;
    height: 6px;
    background-color: #E8202B;
    position: absolute;
    left: 0;
    top: 10px;
  }

  .policy-body ol {
    padding-left: 20px;
    margin-bottom: 32px;
  }
  
  .policy-body ol li {
    margin-bottom: 12px;
    color: #4D4D4D;
  }
  
  .policy-body ol li::marker {
    color: #E8202B;
    font-weight: 700;
  }

  /* --- Links --- */
  .policy-body a {
    color: #E8202B;
    text-decoration: none;
    font-weight: 500;
    position: relative;
    transition: all 0.3s ease;
  }

  .policy-body a::after {
    content: '';
    position: absolute;
    width: 100%;
    transform: scaleX(0);
    height: 1px;
    bottom: -2px;
    left: 0;
    background-color: #E8202B;
    transform-origin: bottom right;
    transition: transform 0.25s ease-out;
  }

  .policy-body a:hover::after {
    transform: scaleX(1);
    transform-origin: bottom left;
  }

  /* --- Mobile Responsive --- */
  @media (max-width: 768px) {
    .policy-section {
      padding-top: 30px;
      padding-bottom: 40px;
    }

    .policy-body h2 {
      font-size: 20px !important; /* Slightly smaller on mobile */
      align-items: center !important;
      flex-direction: row !important;
      border-bottom: 1px solid rgba(232, 32, 43, 0.2) !important;
    }

    .policy-body h2::before {
      font-size: 20px !important;
      margin-right: 10px;
      margin-bottom: 0;
    }
  }
</style>