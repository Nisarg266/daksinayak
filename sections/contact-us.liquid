{% schema %}
{
  "name": "Contact Us Form",
  "settings": [
    {
      "type": "text",
      "id": "heading_left",
      "label": "Left Heading",
      "default": "Get In Touch"
    },
    {
      "type": "textarea",
      "id": "subtext",
      "label": "Subtext",
      "default": "Have questions about our products or want to learn more about Dakshinayan? We'd love to hear from you."
    },
    {
      "type": "text",
      "id": "email",
      "label": "Email Address",
      "default": "info@dakshinayan.in"
    },
    {
      "type": "text",
      "id": "presence_heading",
      "label": "Presence Heading",
      "default": "Our Presence"
    },
    {
      "type": "text",
      "id": "locations",
      "label": "Locations (Separated by |)",
      "default": "Ahmedabad | Mumbai"
    },
    {
      "type": "text",
      "id": "social_heading",
      "label": "Social Heading",
      "default": "Connect With Us"
    },
    {
      "type": "text",
      "id": "form_heading",
      "label": "Form Heading",
      "default": "Send Us A Message"
    }
  ],
  "presets": [
    {
      "name": "Contact Us Form"
    }
  ]
}
{% endschema %}

<div class="cu-section">
  <div class="cu-container">
    
    <div class="cu-left">
      <div class="cu-block">
        <h2 class="cu-heading font-tasman">{{ section.settings.heading_left }}</h2>
        <p class="cu-desc">{{ section.settings.subtext }}</p>
        
        <div class="cu-contact-links">
          <a href="mailto:{{ section.settings.email }}" class="cu-link">
            <span class="cu-icon">
              <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#191919" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                <path d="M22 6V19H3V6M22 6H3M22 6L12.5 12.5L3 6"/>
              </svg>
            </span>
            {{ section.settings.email }}
          </a>
        </div>
      </div>

      <div class="cu-block">
        <h2 class="cu-heading font-tasman">{{ section.settings.presence_heading }}</h2>
        <div class="cu-locations">
          {{ section.settings.locations | replace: '|', '<span style="margin: 0 18px;">|</span>' }}
        </div>
      </div>

      <div class="cu-block">
        <h2 class="cu-heading font-tasman">{{ section.settings.social_heading }}</h2>
        <div class="cu-socials">
          <a target="_blank" href="https://www.instagram.com/_dakshinayan_" class="cu-social-icon">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="2" width="20" height="20" rx="5" ry="5"></rect><path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"></path><line x1="17.5" y1="6.5" x2="17.51" y2="6.5"></line></svg>
          </a>
          <a target="_blank" href="https://www.facebook.com/dakshinayan/" class="cu-social-icon">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z"></path></svg>
          </a>
          <a target="_blank" href="https://www.linkedin.com/company/dakshinayan-foods-pvt-ltd" class="cu-social-icon">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z"></path><rect x="2" y="9" width="4" height="12"></rect><circle cx="4" cy="4" r="2"></circle></svg>
          </a>
        </div>
      </div>
    </div>

    <div class="cu-divider">
