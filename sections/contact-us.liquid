    <div class="cu-right">
      <div class="cu-right-wrapper">
        <h2 class="cu-heading font-tasman">{{ section.settings.form_heading }}</h2>
        <div class="cu-form-box">
          {% form 'contact' %}
            
            {% if form.posted_successfully? %}
              <div class="cat-success">Thanks! We've received your message.</div>
            {% elsif form.errors %}
              <div class="cat-error">{{ form.errors | default_errors }}</div>
            {% endif %}

            <div class="cu-form-grid">
              
              <input type="hidden" name="contact[Source]" value="Contact Us Page">

              <div class="cu-field">
                <label for="ContactFormName">Name *</label>
                <input type="text" id="ContactFormName" name="contact[name]" required>
              </div>

              <div class="cu-field">
                <label for="ContactFormPhone">Phone Number *</label>
                <input type="tel" id="ContactFormPhone" name="contact[phone]" pattern="[0-9\-]*" required>
              </div>

              <div class="cu-field full">
                <label for="ContactFormEmail">Email Address *</label>
                <input type="email" id="ContactFormEmail" name="contact[email]" required>
              </div>

              <div class="cu-field full">
                <label for="ContactFormMessage">Message *</label>
                <textarea id="ContactFormMessage" name="contact[body]" required></textarea>
              </div>

              <button type="submit" class="cat-submit-btn">
                <span>Submit</span>
                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                  <path d="M7.70684 17.5785C5.82572 15.6973 3.87406 13.8925 1.99883 11.9996L12.1451 2L22.1797 12.1583L12.1451 21.9992C11.7924 22.0639 8.2653 18.1428 7.70684 17.5843V17.5785Z" stroke="currentColor" stroke-miterlimit="10"/>
                  <path d="M12.1551 10.4955C10.5033 10.4955 10.4974 13.0645 12.1551 13.0645C13.8129 13.0645 13.8129 10.4955 12.1551 10.4955Z" fill="currentColor"/>
                </svg>
              </button>

            </div>
          {% endform %}
        </div>
      </div>
    </div>

  </div>
</div>

<style>
  /* --- Layout --- */
  .cu-section {
    background-color: #EEE9D7;
    padding: 80px 40px;
    font-family: sans-serif;
    color: var(--color-custom-black);
  }

  .cu-container {
    max-width: 1440px;
    margin: 0 auto;
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 0;
  }

  /* --- Left Side --- */
  .cu-left {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: 36px;
    padding-right: 60px;
    justify-content: center;
  }

  .cu-block {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .cu-heading {
    font-size: 40px;
    color: #E8202B;
    margin: 0;
    font-weight: 600;
  }

  .cu-desc {
    font-size: 18px;
    line-height: 1.5;
    color: #4D4D4D;
    max-width: 649px;
    margin: 0;
  }

  /* Contact Links */
  .cu-contact-links {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .cu-link {
    display: flex;
    align-items: center;
    gap: 16px;
    font-size: 24px;
    color: var(--color-custom-black);
    transition: color 0.3s ease;
  }

  .cu-link:hover {
    color: #E8202B;
  }

  .cu-icon {
    display: flex;
    align-items: center;
    justify-content: center;
  }

  /* Locations */
  .cu-locations {
    font-size: 24px;
    color: var(--color-custom-black);
  }

  /* Socials */
  .cu-socials {
    display: flex;
    gap: 12px;
  }

  .cu-social-icon {
    color: var(--color-custom-black);
    transition: color 0.3s ease, transform 0.3s ease;
  }

  .cu-social-icon:hover {
    color: #E8202B;
    transform: translateY(-3px);
  }

  /* --- Divider --- */
  .cu-divider {
    width: 71px;
    flex-shrink: 0;
    display: flex;
    justify-content: center;
    align-items: center;
  }

  .cu-divider svg {
    height: 100%;
    width: auto;
    max-height: 600px;
  }

  /* --- Right Side --- */
  .cu-right {
    flex: 1;
    display: flex;
    flex-direction: column;
    padding-left: 36px;
    justify-content: center;
    align-items: center;
    gap: 30px;
  }

  /* Wrapper for Heading + Form Box */
  .cu-right-wrapper {
    width: 100%;
    max-width: 649px;
    display: flex;
    flex-direction: column;
    gap: 24px; /* Gap between Heading and Form Box */
  }

  /* Form Box - Border Only Here */
  .cu-form-box {
    width: 100%;
    border: 1px solid rgba(25, 25, 25, 0.08);
    padding: 24px 18.5px;
    box-sizing: border-box;
  }

  .cu-form-grid {
    display: flex;
    flex-wrap: wrap;
    gap: 16px;
  }

  .cu-field {
    width: calc(50% - 8px);
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .cu-field.full {
    width: 100%;
  }

  .cu-field label {
    font-size: 14px;
    color: #4D4D4D;
  }

  .cu-field input,
  .cu-field textarea {
    width: 100%;
    background: transparent;
    border: 1px solid var(--color-custom-black);
    padding: 10px 12px;
    font-size: 16px;
    color: var(--color-custom-black);
    border-radius: 0;
    box-sizing: border-box;
    outline: none;
  }

  .cu-field input { height: 42px; }
  .cu-field textarea { height: 80px; resize: none; }

  .cu-field input:focus, .cu-field textarea:focus {
    border-width: 2px;
  }

  /* Submit Button Reuse */
  .cat-submit-btn {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 12px;
