{% schema %}
{
  "name": "Event Highlights",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Event Highlights"
    }
  ],
  "blocks": [
    {
      "type": "image",
      "name": "Highlight Image",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Event Highlights Slider",
      "blocks": [
        { "type": "image" },
        { "type": "image" },
        { "type": "image" },
        { "type": "image" }
      ]
    }
  ]
}
{% endschema %}

<div class="eh-section">
  <h2 class="eh-heading font-tasman-regular">{{ section.settings.heading }}</h2>
  
  <div class="eh-slider-container" id="eh-slider-{{ section.id }}">
    <div class="eh-track">
      {% for block in section.blocks %}
        <div class="eh-slide">
          {% if block.settings.image != blank %}
            {{ block.settings.image | image_url: width: 800 | image_tag: loading: 'lazy', class: 'eh-img' }}
          {% else %}
            {{ 'lifestyle-1' | placeholder_svg_tag: 'eh-img placeholder' }}
          {% endif %}
        </div>
      {% endfor %}
    </div>
  </div>
</div>

<style>
  /* Section Layout */
  .eh-section {
    width: 100%;
    padding-top: 60px;
    padding-bottom: 60px;
    background-color: #EEE9D7; /* Matches your theme bg */
    display: flex;
    flex-direction: column;
    gap: 48px;
    overflow: hidden; /* Prevents horizontal scrollbar on body */
  }

  .eh-heading {
    color: #e8202b;
    font-size: 56px;
    font-weight: 600;
    text-align: center;
    margin: 0;
    padding: 0 20px;
  }

  /* Slider Logic */
  .eh-slider-container {
    width: 100%;
    overflow-x: auto;
    overflow-y: hidden;
    cursor: grab;
    /* Hide scrollbar */
    scrollbar-width: none; /* Firefox */
    -ms-overflow-style: none;  /* IE 10+ */
    /* Hardware acceleration for smooth drag */
    -webkit-overflow-scrolling: touch;
  }
  
  .eh-slider-container::-webkit-scrollbar { 
    display: none; /* Chrome/Safari */
  }

  .eh-slider-container.active {
    cursor: grabbing;
  }

  .eh-track {
    display: flex;
    gap: 24px;
    width: max-content; /* Allows slides to flow horizontally */
    padding: 0; /* Removed padding so slides stick to edges */
  }

  .eh-slide {
    /* Calculation for 3 slides per view with 24px gap:
       100vw (screen width) 
       minus 48px (2 gaps of 24px between the 3 visible items)
       divide by 3
    */
    width: calc((100vw - 48px) / 3);
    height: 469px; /* Fixed height from Figma */
    flex-shrink: 0;
    user-select: none; /* Prevents highlighting image while dragging */
  }

  .eh-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    pointer-events: none; /* Essential for mouse drag to work on images */
    display: block;
    border-radius: 0;
  }

  .placeholder {
    background: #e1e1e1;
  }

  /* Responsive */
  @media (max-width: 1024px) {
    .eh-heading {
      font-size: 36px;
    }
    
    .eh-slide {
      /* Tablet: 2 slides per view (1 gap of 24px) */
      width: calc((100vw - 24px) / 2);
      height: 350px;
    }
  }

  @media (max-width: 768px) {
    .eh-slide {
      /* Mobile: 1.1 slide per view (peek effect) */
      width: 85vw;
      height: 300px;
    }
    .eh-track {
      gap: 16px;
      /* padding removed here too */
    }
  }

  @media screen and (min-width: 1024px) and (max-width: 1180px) {
    .eh-slide {
      width: calc((100vw - 346px) / 2);
      height: auto;
    }
  }

  @media screen and (min-width: 1181px) and (max-width: 1536px) {
    .eh-slide {
      width: calc((100vw - 346px) / 2);
      height: auto;
    }
  }
</style>

<script>
  (function() {
    const slider = document.getElementById('eh-slider-{{ section.id }}');
    let isDown = false;
    let startX;
    let scrollLeft;

    slider.addEventListener('mousedown', (e) => {
      isDown = true;
      slider.classList.add('active');
      startX = e.pageX - slider.offsetLeft;
      scrollLeft = slider.scrollLeft;
    });

    slider.addEventListener('mouseleave', () => {
      isDown = false;
      slider.classList.remove('active');
    });

    slider.addEventListener('mouseup', () => {
      isDown = false;
      slider.classList.remove('active');
    });

    slider.addEventListener('mousemove', (e) => {
      if (!isDown) return;
      e.preventDefault();
      const x = e.pageX - slider.offsetLeft;
      const walk = (x - startX) * 2; // Scroll-fast speed
      slider.scrollLeft = scrollLeft - walk;
    });
  })();
</script>}