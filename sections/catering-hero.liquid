{%- style -%}
  /* Section Wrapper */
  .catering-section-{{ section.id }} {
    padding: 60px 20px;
    padding-bottom: 0;
    background-color: var(--color-off-white);
    display: block;
    width: 100%;
    overflow: hidden;
  }

  /* Image Box - Figma Width 698px */
  .catering-image-wrapper {
    width: 100%;
    max-width: 698px;
    flex-shrink: 0;
  }

  .catering-image-wrapper img {
    width: 100%;
    height: auto;
    display: block;
    object-fit: cover;
    /* Dummy height for desktop aspect ratio to prevent jump */
    min-height: 200px; 
  }

  /* Content Box - Figma Width 696px */
  .catering-content {
    display: flex;
    flex-direction: column;
    justify-content: flex-start;
    align-items: flex-start;
    width: 100%;
    max-width: 696px;
    gap: 16px;
    margin-top: 2rem;
  }

  .hero-container {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: space-between;
  }

  .catering-title {
    margin: 0;
    font-family: 'font-tasman-bold', sans-serif;
    font-size: 32px; 
    font-weight: 700;
    text-align: center;
    color: var(--color-heading);
    line-height: 1.1;
  }

  .catering-description {
    margin: 0;
    font-size: 16px;
    text-align: left;
    color: var(--color-custom-gray);
    line-height: 1.6;
    letter-spacing: 0;
  }

  .catering-description .bold-city {
    font-weight: 600;
  }

  /* Tablet View */
  @media screen and (min-width: 768px) and (max-width: 1023px) {
    .catering-section-{{ section.id }} {
      padding: 60px 30px;
    }

    .hero-container {
      flex-direction: row;
      gap: 24px;
    }

    .catering-image-wrapper {
      max-width: 50%;
    }

    .catering-title {
      font-size: 40px;
      text-align: left;
    }

    .catering-content {
      gap: 20px;
      margin-top: 0;
    }

    .catering-description {
      font-size: 16px;
    }

    .catering-image-wrapper img {
      height: auto;
    }
  }

  /* Desktop View */
  @media screen and (min-width: 1537px) {
    .catering-section-{{ section.id }} {
      padding: 100px 0;
    }

    .hero-container {
      flex-direction: row;
      gap: 48px;
    }

    .catering-title {
      font-size: 56px;
      text-align: left;
    }

    .catering-content {
      gap: 28px;
      margin-top: 0;
    }

    .catering-description {
      font-size: 18px;
    }

    .catering-image-wrapper img {
      height: 392px; /* Fixed Figma height for Desktop */
    }
  }

  /* Desktop View */
  @media screen and (min-width: 1024px) and (max-width: 1180px) {
  .catering-section-{{ section.id }} {
    padding: 60px ;
  }

  .wte.container {
    margin-top: 0;
  }

  .hero-container {
    flex-direction: row;
    gap: 29px;
  }

  .catering-title {
    font-size: 36px;
    text-align: left;
  }

  .catering-content {
    gap: 17px;
    margin-top: 0;
  }

  .catering-description {
    font-size: 16px;
  }

  .catering-image-wrapper img {
    height: auto;
  }

  .catering-image-wrapper {
    width: 50%;
  }
}

  @media screen and (min-width: 1181px) and (max-width: 1536px) {
  .catering-section-{{ section.id }} {
    padding: 60px 100px;
  }

  .hero-container {
    flex-direction: row;
    gap: 29px;
  }

  .catering-title {
    font-size: 42px;
    text-align: left;
  }

  .catering-content {
    gap: 17px;
    margin-top: 0;
  }

  .catering-description {
    font-size: 18px;
  }

  .catering-image-wrapper img {
    height: auto;
  }

  .catering-image-wrapper {
    width: 50%;
  }
}

{%- endstyle -%}

<section class="catering-section-{{ section.id }}">
  <div class="hero-container container">
    <div class="catering-image-wrapper">
      {%- if section.settings.image != blank -%}
        {%- comment -%} Using image_tag automatically adds width/height based on file {%- endcomment -%}
        {{ section.settings.image | image_url: width: 1400 | image_tag: 
          loading: 'lazy', 
          class: 'catering-main-img',
          alt: section.settings.title,
          width: 698,
          height: 392
        }}
      {%- else -%}
        {%- comment -%} Fallback to Assets Folder {%- endcomment -%}
        <img 
          src="{{ 'catering_image_main.png' | asset_url }}" 
          alt="Dakshinayan Catering" 
          loading="lazy"
          width="698" 
          height="392"
          style="aspect-ratio: 698 / 392;"
        >
      {%- endif -%}
    </div>

    <div class="catering-content">
      <h2 class="catering-title font-tasman-bold">
        {{ section.settings.title }}
      </h2>
      <div class="catering-description">
        <p style="margin-top: 0;">
          Dakshinayan offers authentic South Indian vegetarian catering services exclusively in 
          <span class="bold-city">Ahmedabad</span>.
        </p>
        <p>
          Perfect for events and group functions, our catering menu includes classic dosas, idlis, 
          vadas, rice preparations, sweets and traditional South Indian specialties — all freshly 
          prepared and served with care.
        </p>
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Catering Hero",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Main Catering Image"
    },
    {
      "type": "inline_richtext",
      "id": "title",
      "label": "Heading",
      "default": "Dakshinayan Catering"
    }
  ],
  "presets": [
    {
      "name": "Catering Hero"
    }
  ]
}
{% endschema %}