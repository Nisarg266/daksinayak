      "id": "color_text",
      "label": "Button Text Color",
      "default": "#191919"
    },
    {
      "type": "color",
      "id": "color_bg",
      "label": "Button Background Color",
      "default": "transparent"
    },
    {
      "type": "color",
      "id": "hover_text",
      "label": "Button Hover Text Color",
      "default": "#ffffff"
    },
    {
      "type": "color",
