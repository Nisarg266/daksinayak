{{ 'template-collection.css' | asset_url | stylesheet_tag }}
{{ 'component-card.css' | asset_url | stylesheet_tag }}
{{ 'component-price.css' | asset_url | stylesheet_tag }}
{{ 'quick-add.css' | asset_url | stylesheet_tag }}
<script src="{{ 'quick-add.js' | asset_url }}" defer></script>
<script src="{{ 'product-form.js' | asset_url }}" defer></script>

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }
  .product-grid {
    display: flex;
    flex-wrap: wrap;
    margin-bottom: 2rem;
    padding: 0;
    list-style: none;
    column-gap: var(--grid-mobile-horizontal-spacing);
    gap: 24px;
  }

  .grid--4-col-desktop .grid__item {
    width: calc(25% - (24px * 3 / 4));
    max-width: calc(25% - (24px * 3 / 4));
  }

  @media screen and (max-width: 767px) {
    .related-products__heading {
      font-size: 28px !important;
    }
    .product-grid {
      overflow-x: scroll !important;
      display: flex;
      margin-bottom: 2rem;
      padding: 0;
      list-style: none;
      column-gap: 3rem;
      row-gap: 3rem;
    }
    .product-grid::-webkit-scrollbar {
      display: none;
    }

    .grid--4-col-desktop .custom-products-mobile-grid {
      width: calc(50% - (24px * 3 / 4));
      max-width: calc(50% - (24px * 3 / 4));
    }
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }

  .related-products__heading {
    color: var(--color-heading);
    font-size: 56px;
    margin: 0;
    line-height: 1.1;
    text-align: center;
    margin-bottom: 32px;
  }

  @media screen and (min-width: 1024px) and (max-width: 1180px) {
    .related-products__heading {
      font-size: 36px;
    }
  }

  @media screen and (min-width: 1181px) and (max-width: 1536px) {
    .related-products__heading {
      font-size: 46px;
    }
  }

  .margin-bottom-custom {
    margin-bottom: 46px;
  }

  
{%- endstyle -%}

<div class="color-{{ section.settings.color_scheme }} gradient">
  <div class="page-width section-{{ section.id }}-padding isolate">
    {%- if section.settings.heading != blank -%}
      <h2 class="related-products__heading font-tasman inline-richtext {{ section.settings.heading_size }}">
        {{ section.settings.heading }}
      </h2>
    {%- endif -%}

    <ul
      id="RandomProductGrid-{{ section.id }}"
      class="product-grid grid--{{ section.settings.columns_desktop }}-col-desktop grid--{{ section.settings.columns_mobile }}-col-tablet-down"
      role="list"
    >
      {%- assign random_collection = collections[section.settings.collection] -%}
      {%- for product in random_collection.products limit: 20 -%}
        <li class="grid__item custom-products-mobile-grid random-product-card random-product-card--hidden">
          {% render 'custom-card-product',
            card_product: product,
            media_aspect_ratio: section.settings.image_ratio,
            image_shape: section.settings.image_shape,
            show_secondary_image: section.settings.show_secondary_image,
            show_vendor: section.settings.show_vendor,
            show_rating: section.settings.show_rating,
            quick_add: 'standard',
            section_id: section.id
          %}
        </li>
      {%- endfor -%}
    </ul>
  </div>
  {%- if section.settings.show_view_all -%}
    <div class="center margin-bottom-custom collection__view-all{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}">
      {% render 'custom-cta-button', label: section.settings.btn_text, default: 'View all', link: section.settings.btn_url, text_color: section.settings.color_text, bg_color: section.settings.color_bg, hover_text: section.settings.hover_text, hover_bg: section.settings.hover_bg %}
    </div>
  {%- endif -%}
</div>

<style>
  .random-product-card--hidden {
    position: absolute !important;
    visibility: hidden !important;
    opacity: 0 !important;
    pointer-events: none !important;
  }
  .random-product-card--visible {
    position: static !important;
    visibility: visible !important;
    opacity: 1 !important;
    pointer-events: auto !important;
  }
</style>

<script>
  document.addEventListener('DOMContentLoaded', function() {
    const grid = document.getElementById('RandomProductGrid-{{ section.id }}');
    const cards = Array.from(grid.querySelectorAll('.random-product-card'));
    const limit = {{ section.settings.products_to_show }};

    // Fisher-Yates Shuffle
    for (let i = cards.length - 1; i > 0; i--) {
      const j = Math.floor(Math.random() * (i + 1));
      [cards[i], cards[j]] = [cards[j], cards[i]];
    }

    // Remove unwanted cards from DOM
    cards.slice(limit).forEach(card => {
      card.remove();
    });

    // Show the selected cards by swapping classes
    cards.slice(0, limit).forEach(card => {
      card.classList.remove('random-product-card--hidden');
      card.classList.add('random-product-card--visible');

      // Ensure the variant ID input is enabled
      const variantInputs = card.querySelectorAll('input[name="id"]');
      variantInputs.forEach(input => {
        input.disabled = false;
      });
    });
  });
</script>

{% schema %}
{
